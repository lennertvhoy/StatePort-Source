{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.invalid/schemas/rights-inventory.v1.schema.json",
  "title": "StatePort rights inventory v1",
  "description": "Typed per-file rights inventory contract. Defines the entry shape only; the presence of this schema does not claim that any inventory is complete.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "metadata", "files"],
  "properties": {
    "formatVersion": {"const": "stateport.rights-inventory/v1"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "files": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "scope", "completeness", "notes"],
      "properties": {
        "created": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "scope": {"type": "string", "minLength": 1, "maxLength": 2048},
        "completeness": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Honest coverage statement; an inventory must not claim completeness it has not verified."
        },
        "notes": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "category",
        "proposedLicence",
        "source",
        "attribution",
        "redistributable",
        "publicExportDecision",
        "evidence",
        "reviewerStatus"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "category": {
          "enum": [
            "owned_code",
            "owned_documentation",
            "generated_owned_output",
            "third_party_redistributable",
            "third_party_review_required",
            "canonical_upstream_reference",
            "user_or_private_data",
            "excluded_private_engineering"
          ]
        },
        "proposedLicence": {"type": "string", "minLength": 1, "maxLength": 256},
        "source": {"type": "string", "minLength": 1, "maxLength": 1024},
        "attribution": {"type": "string", "minLength": 1, "maxLength": 1024},
        "redistributable": {"type": "boolean"},
        "publicExportDecision": {
          "enum": ["include", "exclude", "transform", "review_required"]
        },
        "evidence": {"type": "string", "minLength": 1, "maxLength": 2048},
        "reviewerStatus": {
          "enum": ["unreviewed", "reviewed_internal", "reviewed_independent"]
        }
      }
    }
  }
}
