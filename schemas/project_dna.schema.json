{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "statedd.stateport.project_dna.v1",
  "title": "StatePort PROJECT_DNA.yaml",
  "type": "object",
  "required": ["version", "schema_version", "project", "truth_rules", "architecture", "principles", "compliance_stance", "product_boundary", "naming", "invariants"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "string", "const": "statedd-template-v5" },
    "schema_version": { "type": "string", "minLength": 1 },
    "project": {
      "type": "object",
      "required": ["name", "spec", "thesis"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "spec": { "type": "string", "const": "StateDD" },
        "thesis": { "type": "string", "minLength": 1 }
      }
    },
    "truth_rules": { "type": "object", "additionalProperties": true },
    "architecture": { "type": "object", "additionalProperties": true },
    "invariants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "principles": { "type": "array", "items": { "type": "string" } },
    "compliance_stance": { "type": "object", "additionalProperties": true },
    "product_boundary": { "type": "object", "additionalProperties": true },
    "naming": {
      "type": "object",
      "required": ["public_product", "technical_spec"],
      "additionalProperties": true,
      "properties": {
        "public_product": { "type": "string", "minLength": 1 },
        "technical_spec": { "type": "string", "minLength": 1 }
      }
    }
  }
}
