{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.invalid/schemas/update-failure-evidence.v1.schema.json",
  "title": "StatePort retained update failure evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "failureId", "planId", "planDigest", "successor", "failedStep", "errorCode", "safeSummary", "artifacts", "retained", "observedAt"],
  "properties": {
    "schema": {"const": "stateport.update-failure-evidence/v1"},
    "failureId": {"type": "string", "pattern": "^update_failure_[0-9a-f]{32}$"},
    "planId": {"type": "string", "pattern": "^update_plan_[0-9a-f]{32}$"},
    "planDigest": {"$ref": "#/$defs/digest"},
    "successor": {
      "type": "object", "additionalProperties": false,
      "required": ["releaseId", "version", "signedPayloadDigest"],
      "properties": {
        "releaseId": {"type": "string", "minLength": 3, "maxLength": 128},
        "version": {"type": "string", "minLength": 5, "maxLength": 128},
        "signedPayloadDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "failedStep": {"enum": ["verify", "backup", "pull", "stage", "dry-run-migrations", "start-successor", "health-successor", "browser-successor", "studystate-successor", "state-check-successor", "switch", "health-accepted-route", "state-check-accepted-route", "retain-predecessor", "record-receipt"]},
    "errorCode": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$"},
    "safeSummary": {"type": "string", "minLength": 1, "maxLength": 2048},
    "artifacts": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/artifact"}},
    "retained": {"const": true},
    "observedAt": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["locator", "digest", "size"],
      "properties": {
        "locator": {"type": "string", "pattern": "^operator://[A-Za-z0-9._/-]+$"},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1, "maximum": 1073741824}
      }
    }
  }
}
