{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.local/schemas/deployment-state.v1.schema.json",
  "title": "StatePort durable deployment state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "deploymentId", "applicationId", "revision", "lifecycleState", "sourceIdentity", "approvedPlanDigest", "acceptedRevision", "desiredRevision", "observedRevision", "imageDigests", "serviceHealth", "targetIdentity", "storageIdentities", "secretBindingIdentifiers", "currentTransition", "transitionHistory", "receipts", "authorityReceipts", "lastSuccessfulObservation", "driftStatus", "rollbackPredecessor", "infrastructureIdentity", "removalState", "retainedDataState", "createdAt", "updatedAt", "stateDigest"],
  "properties": {
    "schema": {"const": "stateport.deployment-state/v1"},
    "deploymentId": {"$ref": "#/$defs/id"},
    "applicationId": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "lifecycleState": {"enum": ["discovered", "planned", "awaiting_approval", "approved", "applying", "verifying", "healthy", "degraded", "failed", "update_planned", "updating", "rollback_required", "rolling_back", "removed_runtime_data_retained", "purged", "reconciliation_required"]},
    "sourceIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["repositoryIdentity", "repositoryRoot", "projectPath", "commit", "treeDigest", "dirty", "dirtyDigest", "dirtyPolicy", "descriptorDigest"],
      "properties": {
        "repositoryIdentity": {"$ref": "#/$defs/digest"},
        "repositoryRoot": {"type": "string", "minLength": 1, "pattern": "^/"},
        "projectPath": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "treeDigest": {"$ref": "#/$defs/digest"},
        "dirty": {"type": "boolean"},
        "dirtyDigest": {"$ref": "#/$defs/digest"},
        "dirtyPolicy": {"const": "refuse"},
        "descriptorDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "approvedPlanDigest": {"$ref": "#/$defs/digestOrNull"},
    "acceptedRevision": {"$ref": "#/$defs/digestOrNull"},
    "desiredRevision": {"$ref": "#/$defs/digestOrNull"},
    "observedRevision": {"$ref": "#/$defs/digestOrNull"},
    "imageDigests": {"type": "object", "additionalProperties": {"$ref": "#/$defs/digest"}},
    "serviceHealth": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["status"],
        "properties": {"status": {"enum": ["healthy", "unhealthy", "absent", "unknown", "exited"]}}
      }
    },
    "targetIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "targetId", "architecture", "identityDigest"],
      "properties": {
        "adapter": {"const": "rootless-podman-local"},
        "targetId": {"const": "local"},
        "architecture": {"const": "linux-amd64"},
        "identityDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "storageIdentities": {"type": "object", "additionalProperties": {"type": "string"}},
    "dataBackups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["backupId", "backupDigest", "sourceRevision", "createdAt", "status", "storage", "restoredAt"],
        "properties": {
          "backupId": {"$ref": "#/$defs/id"},
          "backupDigest": {"$ref": "#/$defs/digest"},
          "sourceRevision": {"$ref": "#/$defs/digest"},
          "createdAt": {"$ref": "#/$defs/timestamp"},
          "status": {"enum": ["available", "restored_consumed"]},
          "storage": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
                "required": ["artifactId", "contentDigest", "fileCount", "bytes"],
                "properties": {
                  "artifactId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}\\.tar$"},
                "contentDigest": {"$ref": "#/$defs/digest"},
                "fileCount": {"type": "integer", "minimum": 0},
                "bytes": {"type": "integer", "minimum": 0}
              }
            }
          },
          "restoredAt": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
        }
      }
    },
    "secretBindingIdentifiers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^secret-broker://"}},
    "currentTransition": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["operationId", "operation", "planDigest", "phase", "startedAt", "authorityDecision"],
          "properties": {
            "operationId": {"type": "string", "pattern": "^operation_"},
            "operation": {"enum": ["apply", "update", "rollback", "backup_data", "restore_data", "restart", "remove", "purge_data"]},
            "planDigest": {"$ref": "#/$defs/digest"},
            "phase": {"enum": ["executing", "verifying", "failed", "observation_failed", "interrupted_observed"]},
            "startedAt": {"$ref": "#/$defs/timestamp"},
            "authorityDecision": {"type": "object"},
            "failureCode": {"type": "string"},
            "details": {"type": "object"},
            "contextDigest": {"$ref": "#/$defs/digest"},
            "contextCleanup": {"type": "object"}
          }
        }
      ]
    },
    "transitionHistory": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "to", "receiptId", "at"],
        "properties": {
          "from": {"$ref": "#/$defs/lifecycle"},
          "to": {"$ref": "#/$defs/lifecycle"},
          "receiptId": {"type": "string", "pattern": "^receipt_"},
          "at": {"$ref": "#/$defs/timestamp"}
        }
      }
    },
    "receipts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^receipt_"}},
    "authorityReceipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receiptId", "receiptDigest", "requestId", "action", "resultStatus", "grantId", "decisionDigest", "reservationId", "reservationDigest", "claimId", "claimDigest", "evidence"],
        "properties": {
          "receiptId": {"type": "string", "pattern": "^authority_receipt_"},
          "receiptDigest": {"$ref": "#/$defs/digest"},
          "requestId": {"type": "string", "pattern": "^authority_request_"},
          "action": {"type": "string", "minLength": 1},
          "resultStatus": {"enum": ["succeeded", "failed"]},
          "grantId": {"$ref": "#/$defs/grantId"},
          "decisionDigest": {"$ref": "#/$defs/digest"},
          "reservationId": {"type": "string", "pattern": "^authority_reservation_[0-9a-f]{32}$"},
          "reservationDigest": {"$ref": "#/$defs/digest"},
          "claimId": {"type": "string", "pattern": "^authority_claim_[0-9a-f]{32}$"},
          "claimDigest": {"$ref": "#/$defs/digest"},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidenceId", "path", "payloadDigest"],
            "properties": {
              "evidenceId": {"type": "string", "pattern": "^evidence_authority_receipt_"},
              "path": {"type": "string", "minLength": 1},
              "payloadDigest": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    },
    "lastSuccessfulObservation": {"type": ["object", "null"]},
    "driftStatus": {"enum": ["not_observed", "in_sync", "drifted", "unknown", "runtime_absent_data_may_be_retained"]},
    "rollbackPredecessor": {"$ref": "#/$defs/digestOrNull"},
    "infrastructureIdentity": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["networks", "volumes"],
          "properties": {
            "networks": {"type": "object", "additionalProperties": {"$ref": "#/$defs/infrastructureResource"}},
            "volumes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/infrastructureResource"}}
          }
        }
      ]
    },
    "removalState": {"enum": ["runtime_absent", "runtime_present", "runtime_removed", "runtime_removed_data_purged"]},
    "retainedDataState": {"enum": ["not_created", "present", "not_applicable", "retained", "retained_after_failed_apply", "purged"]},
    "createdAt": {"$ref": "#/$defs/timestamp"},
    "updatedAt": {"$ref": "#/$defs/timestamp"},
    "stateDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "grantId": {"type": "string", "pattern": "^grant_[A-Za-z0-9][A-Za-z0-9._-]{2,95}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "digestOrNull": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "infrastructureResource": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "sourceCommit"],
      "properties": {
        "revision": {"$ref": "#/$defs/digest"},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    },
    "lifecycle": {"enum": ["discovered", "planned", "awaiting_approval", "approved", "applying", "verifying", "healthy", "degraded", "failed", "update_planned", "updating", "rollback_required", "rolling_back", "removed_runtime_data_retained", "purged", "reconciliation_required"]}
  }
}
