{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.dev/schemas/frontend-dynamic-preservation.v1.schema.json",
  "title": "FrontendDynamicPreservationManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "scope", "controls", "operations", "behaviors"],
  "properties": {
    "formatVersion": {"const": "stateport.frontend-dynamic-preservation/v1"},
    "scope": {"const": "BL-WORKSPACE-002"},
    "controls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "behaviors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,159}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "contains"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "contains": {"type": "string", "minLength": 1}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "operation", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "method": {"enum": ["GET", "POST"]},
        "operation": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{1,79}$"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    }
  }
}
