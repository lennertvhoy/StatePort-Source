{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.invalid/schemas/release-scan-exceptions.v1.schema.json",
  "title": "StatePort release vulnerability scan exceptions v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "resolvedOn", "exceptions"],
  "properties": {
    "formatVersion": {"const": "stateport.release-scan-exceptions/v1"},
    "resolvedOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "exceptions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "advisory",
          "package",
          "images",
          "severity",
          "surface",
          "reachability",
          "evidence",
          "remediation",
          "expiresOn"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^RX-[0-9]{4}-[0-9]{3}$"},
          "advisory": {
            "type": "string",
              "pattern": "^(CVE-[0-9]{4}-[0-9]{4,}|GHSA-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}|GO-[0-9]{4}-[0-9]{4,})$"
          },
          "package": {"type": "string", "minLength": 1, "maxLength": 128},
          "packageVersion": {"type": "string", "minLength": 1, "maxLength": 128},
          "artifactPath": {
            "type": "string",
            "minLength": 2,
            "maxLength": 1024,
            "pattern": "^/[^\\n\\r]*$"
          },
          "images": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^stateport-[a-z0-9-]+$"}
          },
          "severity": {"enum": ["Critical", "High"]},
          "surface": {"type": "string", "minLength": 16, "maxLength": 1024},
          "reachability": {"type": "string", "minLength": 16, "maxLength": 2048},
          "evidence": {"type": "string", "minLength": 16, "maxLength": 1024},
          "remediation": {"type": "string", "minLength": 16, "maxLength": 1024},
          "expiresOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
        }
      }
    }
  }
}
