{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.invalid/schemas/revision-activation-decision.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "decisionId", "operationPlanDigest", "activationPlanDigest", "predecessorPointerDigest", "predecessorDecisionDigest", "releaseId", "signedPayloadDigest", "targetId", "topologyDigest", "pointerGeneration", "acceptedDataGeneration", "acceptedDataGenerationDigest", "dataPromotionReceiptDigest", "ownerBundleDigests", "portAllocationReceiptDigest", "portActivationRecheckReceiptDigest", "authorityReservationProof", "authorityClaimProof", "signatureVerificationProofSetDigest", "revisionUnitProjectionDigest", "routeProjectionDigest", "decidedAt", "state", "decisionDigest"],
  "properties": {
    "schema": {"const": "stateport.revision-activation-decision/v1"},
    "decisionId": {"type": "string", "pattern": "^revision_activation_decision_[0-9a-f]{32}$"},
    "operationPlanDigest": {"$ref": "#/$defs/digest"},
    "activationPlanDigest": {"$ref": "#/$defs/digest"},
    "predecessorPointerDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "predecessorDecisionDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "releaseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "signedPayloadDigest": {"$ref": "#/$defs/digest"},
    "targetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "topologyDigest": {"$ref": "#/$defs/digest"},
    "pointerGeneration": {"type": "integer", "minimum": 1},
    "acceptedDataGeneration": {"type": "string", "pattern": "^data_[0-9a-f]{32}$"},
    "acceptedDataGenerationDigest": {"$ref": "#/$defs/digest"},
    "dataPromotionReceiptDigest": {"$ref": "#/$defs/digest"},
    "ownerBundleDigests": {"$ref": "#/$defs/ownerBundles"},
    "portAllocationReceiptDigest": {"$ref": "#/$defs/digest"},
    "portActivationRecheckReceiptDigest": {"$ref": "#/$defs/digest"},
    "authorityReservationProof": {"type": "object"},
    "authorityClaimProof": {"type": "object"},
    "signatureVerificationProofSetDigest": {"$ref": "#/$defs/digest"},
    "revisionUnitProjectionDigest": {"$ref": "#/$defs/digest"},
    "routeProjectionDigest": {"$ref": "#/$defs/digest"},
    "decidedAt": {"$ref": "#/$defs/timestamp"},
    "state": {"const": "activation_decided"},
    "decisionDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "ownerBundles": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["owner", "digest"], "properties": {"owner": {"const": "stateport-control"}, "digest": {"$ref": "#/$defs/digest"}}}}
  }
}
