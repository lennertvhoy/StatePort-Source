{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.local/schemas/preview-route.v1.schema.json",
  "title": "StatePort preview route v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "routeId",
    "capsuleId",
    "serviceId",
    "revisionDigest",
    "upstream",
    "createdAt",
    "expiresAt",
    "revokedAt",
    "revocationReason",
    "routeDigest"
  ],
  "properties": {
    "schema": {
      "const": "stateport.preview-route/v1"
    },
    "routeId": {
      "type": "string",
      "pattern": "^route_[0-9a-f]{24}$"
    },
    "capsuleId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "serviceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "revisionDigest": {
      "$ref": "#/$defs/digest"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "const": "127.0.0.1"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "expiresAt": {
      "$ref": "#/$defs/timestamp"
    },
    "revokedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "revocationReason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "routeDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
