{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.invalid/schemas/release-disposition.v1.schema.json",
  "title": "StatePort release work disposition ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "metadata", "items"],
  "properties": {
    "formatVersion": {"const": "stateport.release-disposition/v1"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created",
        "phase",
        "baseHead",
        "purpose",
        "status",
        "coveredPrs",
        "decisionCounts",
        "notes"
      ],
      "properties": {
        "created": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "phase": {"type": "string", "minLength": 1, "maxLength": 32},
        "baseHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 4096},
        "status": {"type": "string", "minLength": 1, "maxLength": 64},
        "coveredPrs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "decisionCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port",
            "superseded",
            "reject",
            "unresolved",
            "transient_carrier",
            "validation_only"
          ],
          "properties": {
            "port": {"type": "integer", "minimum": 0},
            "superseded": {"type": "integer", "minimum": 0},
            "reject": {"type": "integer", "minimum": 0},
            "unresolved": {"type": "integer", "minimum": 0},
            "transient_carrier": {"type": "integer", "minimum": 0},
            "validation_only": {"type": "integer", "minimum": 0}
          }
        },
        "notes": {"type": "string", "minLength": 1, "maxLength": 8192}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "commits"],
      "properties": {
        "kind": {"enum": ["pr_head", "branch_tip", "commit_set"]},
        "pr": {"type": "integer", "minimum": 1},
        "ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "commits": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "recoveryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blob",
        "markerOffsetBytes",
        "marker",
        "observedSha256",
        "pinnedSha256",
        "gzipDecode",
        "decodedPatchBytes",
        "hunksDecodable",
        "verdictTaxonomy"
      ],
      "properties": {
        "blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "blobNote": {"type": "string", "minLength": 1, "maxLength": 1024},
        "markerOffsetBytes": {"type": "integer", "minimum": 0},
        "marker": {"type": "string", "minLength": 1, "maxLength": 256},
        "truncationNote": {"type": "string", "minLength": 1, "maxLength": 1024},
        "observedSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pinnedSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pinVerdict": {"type": "string", "minLength": 1, "maxLength": 1024},
        "gzipDecode": {"type": "string", "minLength": 1, "maxLength": 1024},
        "decodedPatchBytes": {"type": "integer", "minimum": 0},
        "hunksDecodable": {"type": "string", "minLength": 1, "maxLength": 64},
        "verdictTaxonomy": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "classificationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr", "head", "classification", "detail"],
      "properties": {
        "pr": {"type": "integer", "minimum": 1},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "classification": {"enum": ["transient_carrier", "validation_only"]},
        "detail": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "currentMainEquivalent",
        "decision",
        "decisionStatus",
        "securityImplications",
        "requiredReview",
        "requiredTests",
        "reason"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "source": {"$ref": "#/$defs/source"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        },
        "provenance": {"const": "provenance_missing"},
        "recoveryStatus": {
          "enum": [
            "recovered_and_valid",
            "recovered_but_no_longer_applies",
            "corrupt_hash_mismatch",
            "genuinely_unavailable"
          ]
        },
        "recoveryEvidence": {"$ref": "#/$defs/recoveryEvidence"},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 8192},
        "currentMainEquivalent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^(none|n/a)$|^(none|n/a) — |^partial:|^equivalent:"
        },
        "decision": {
          "enum": [
            "port",
            "superseded",
            "reject",
            "unresolved",
            "transient_carrier",
            "validation_only"
          ]
        },
        "decisionStatus": {"enum": ["proposed", "accepted", "rejected"]},
        "ownerIdentity": {"type": "string", "minLength": 1, "maxLength": 256},
        "ownerDecisionDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "supersededBy": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "representedBy": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"}
        },
        "securityImplications": {"type": ["string", "null"], "maxLength": 4096},
        "requiredReview": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "requiredTests": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "blockers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "classification": {
          "type": "array",
          "items": {"$ref": "#/$defs/classificationEntry"}
        },
        "reviewClassification": {"$ref": "#/$defs/reviewClassification"},
        "ownerGate": {"$ref": "#/$defs/ownerGate"},
        "implementation": {"$ref": "#/$defs/implementation"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "reviewClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "approvalStatus"],
      "properties": {
        "decision": {
          "enum": ["unresolved", "port_as_appropriate", "superseded", "rejected"]
        },
        "approvalStatus": {
          "enum": ["technically_approved", "pending", "rejected"]
        }
      }
    },
    "ownerGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "status",
        "ownerIdentity",
        "ownerDecisionDate",
        "decisionRecord"
      ],
      "properties": {
        "type": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"enum": ["satisfied", "pending", "blocked"]},
        "ownerIdentity": {"type": "string", "minLength": 1, "maxLength": 256},
        "ownerDecisionDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "decisionRecord": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "branch", "head", "mergedToCanonical"],
      "properties": {
        "status": {
          "enum": [
            "implemented_on_private_review_branch",
            "not_started",
            "in_progress",
            "ported_to_canonical",
            "superseded"
          ]
        },
        "branch": {"type": "string", "minLength": 1, "maxLength": 256},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "mergedToCanonical": {"type": "boolean"},
        "headNote": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    }
  }
}
