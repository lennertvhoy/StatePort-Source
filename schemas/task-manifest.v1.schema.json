{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "jobId", "taskId", "identity", "requestedMode", "repository", "instance", "baseSha", "allowedPaths", "ownership", "inputs", "preflight", "execution", "verification", "outputs", "failure", "budgets", "sideEffects", "closure"],
  "properties": {
    "formatVersion": {"const": "stateport.task-manifest/v1"},
    "jobId": {"type": "string", "minLength": 1, "maxLength": 128}, "taskId": {"type": "string", "minLength": 1, "maxLength": 128},
    "identity": {"type": "object", "additionalProperties": false, "properties": {"application": {"type": "string", "minLength": 1, "maxLength": 128}, "action": {"type": "string", "minLength": 1, "maxLength": 128}, "developmentWorkflow": {"type": "string", "minLength": 1, "maxLength": 128}}, "oneOf": [{"required": ["application", "action"]}, {"required": ["developmentWorkflow"]}]},
    "requestedMode": {"enum": ["agent_native", "assisted", "managed"]},
    "repository": {"$ref": "#/$defs/digestReference"}, "instance": {"$ref": "#/$defs/digestReference"},
    "baseSha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "allowedPaths": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}},
    "ownership": {"type": "object", "minProperties": 1, "maxProperties": 128, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 128}},
    "inputs": {"type": "array", "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["name", "type", "required"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 128}, "type": {"type": "string", "minLength": 1, "maxLength": 128}, "required": {"type": "boolean"}, "valueDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}},
    "preflight": {"$ref": "#/$defs/argvCommand"},
    "execution": {"type": "object", "additionalProperties": false, "required": ["requirements"], "properties": {"requirements": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}}},
    "verification": {"$ref": "#/$defs/argvCommand"},
    "outputs": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["name", "path", "type"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 128}, "path": {"type": "string", "minLength": 1, "maxLength": 4096}, "type": {"type": "string", "minLength": 1, "maxLength": 128}}}},
    "failure": {"type": "object", "additionalProperties": false, "required": ["action", "rollbackRequired"], "properties": {"action": {"const": "report_and_stop"}, "rollbackRequired": {"type": "boolean"}}},
    "budgets": {"$ref": "#/$defs/budgets"},
    "sideEffects": {"type": "array", "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["id", "classification", "automaticRetryAllowed", "approvalRequired"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "classification": {"enum": ["none", "idempotent", "compensated", "external", "filesystem_transaction", "unknown"]}, "automaticRetryAllowed": {"type": "boolean"}, "approvalRequired": {"type": "boolean"}}, "allOf": [{"if": {"properties": {"automaticRetryAllowed": {"const": true}}, "required": ["automaticRetryAllowed"]}, "then": {"properties": {"classification": {"enum": ["none", "idempotent"]}}}}]}},
    "closure": {"type": "object", "additionalProperties": false, "required": ["requireCleanWorktree", "requireReceipt"], "properties": {"requireCleanWorktree": {"const": true}, "requireReceipt": {"const": true}}}
  },
  "$defs": {
    "digestReference": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}},
    "argvCommand": {"type": "object", "additionalProperties": false, "required": ["command", "timeoutSeconds"], "properties": {"command": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}, "timeoutSeconds": {"type": "integer", "minimum": 1}}},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["token", "costMinor", "timeSeconds", "steps"], "properties": {"token": {"type": "integer", "minimum": 0}, "costMinor": {"type": "integer", "minimum": 0}, "timeSeconds": {"type": "integer", "minimum": 0}, "steps": {"type": "integer", "minimum": 0}}}
  }
}
