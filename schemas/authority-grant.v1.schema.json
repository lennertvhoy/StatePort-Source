{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.local/schemas/authority-grant.v1.schema.json",
  "title": "StatePort standing authority grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "grantId", "kind", "profile", "subject", "scope", "allow",
    "requireApproval", "forbid", "customPolicies", "limits", "issuedAt",
    "expiresWhen", "expiresAt", "ownerDirectiveId", "parentGrantId",
    "canDelegate", "policyDigest", "grantDigest"
  ],
  "properties": {
    "schema": {"const": "stateport.authority-grant/v1"},
    "grantId": {"type": "string", "pattern": "^grant_[A-Za-z0-9][A-Za-z0-9._-]{2,95}$"},
    "kind": {"enum": ["standing", "one_time"]},
    "profile": {"enum": ["guarded", "balanced", "delegated", "custom"]},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["actorId", "role"],
      "properties": {
        "actorId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "role": {"enum": ["primary", "subagent", "operator"]}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "branchPattern", "sliceId", "applicationId", "runId", "paths"],
      "properties": {
        "repository": {
          "type": "object", "additionalProperties": false,
          "required": ["repositoryKey", "repositoryRoot", "origin"],
          "properties": {
            "repositoryKey": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
            "repositoryRoot": {"type": "string", "minLength": 1},
            "origin": {"type": ["string", "null"]}
          }
        },
        "branchPattern": {"type": ["string", "null"], "maxLength": 255},
        "sliceId": {"type": ["string", "null"], "maxLength": 128},
        "applicationId": {"type": ["string", "null"], "maxLength": 128},
        "runId": {"type": ["string", "null"], "maxLength": 128},
        "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 512}},
        "deploymentSources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repositoryIdentity", "projectPath"],
            "properties": {
              "repositoryIdentity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "projectPath": {"type": "string", "minLength": 1, "maxLength": 512}
            }
          }
        }
      }
    },
    "allow": {"$ref": "#/$defs/actionList"},
    "requireApproval": {"$ref": "#/$defs/actionList"},
    "forbid": {"$ref": "#/$defs/actionList"},
    "customPolicies": {
      "type": "object",
      "additionalProperties": {"enum": ["deny", "ask_each_time", "approve_scope_once", "auto_and_notify", "auto_with_receipt"]}
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxActions", "maxDurationSeconds", "maxCostUsd", "network", "allowedDomains", "providers", "secretCapabilities"],
      "properties": {
        "maxActions": {"type": ["integer", "null"], "minimum": 1},
        "maxDurationSeconds": {"type": ["integer", "null"], "minimum": 1},
        "maxCostUsd": {"type": ["number", "null"], "minimum": 0},
        "network": {"enum": ["denied", "allowlisted", "unrestricted"]},
        "allowedDomains": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 253}},
        "providers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
        "secretCapabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 128}}
      }
    },
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresWhen": {"enum": ["revoked", "slice_closed", "run_closed", "timestamp", "one_action"]},
    "expiresAt": {"type": ["string", "null"], "format": "date-time"},
    "ownerDirectiveId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "parentGrantId": {"type": ["string", "null"], "maxLength": 128},
    "canDelegate": {"type": "boolean"},
    "policyDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "grantDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "actionList": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
    }
  }
}
