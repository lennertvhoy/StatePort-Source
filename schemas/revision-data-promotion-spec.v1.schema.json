{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.invalid/schemas/revision-data-promotion-spec.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "operationPlanDigest", "releaseId", "signedPayloadDigest", "targetId", "topologyDigest", "predecessorPointerDigest", "predecessorReleaseId", "predecessorSignedPayloadDigest", "predecessorDataGeneration", "predecessorDataGenerationDigest", "expectedAcceptedDataGeneration", "requiredVolumeKeys", "databaseMigrationVersion", "rollbackDataCompatible", "specDigest"],
  "properties": {
    "schema": {"const": "stateport.revision-data-promotion-spec/v1"},
    "operationPlanDigest": {"$ref": "#/$defs/digest"},
    "releaseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "signedPayloadDigest": {"$ref": "#/$defs/digest"},
    "targetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "topologyDigest": {"$ref": "#/$defs/digest"},
    "predecessorPointerDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "predecessorReleaseId": {"oneOf": [{"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"}, {"type": "null"}]},
    "predecessorSignedPayloadDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "predecessorDataGeneration": {"oneOf": [{"type": "string", "pattern": "^data_[0-9a-f]{32}$"}, {"type": "null"}]},
    "predecessorDataGenerationDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "expectedAcceptedDataGeneration": {"type": "string", "pattern": "^data_[0-9a-f]{32}$"},
    "requiredVolumeKeys": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^stateport-[a-z0-9-]+:[a-z][a-z0-9-]{0,62}$"}},
    "databaseMigrationVersion": {"type": "integer", "minimum": 0},
    "rollbackDataCompatible": {"type": "boolean"},
    "specDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
