{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.invalid/schemas/terminology-policy.v1.schema.json",
  "title": "StatePort public terminology and compatibility policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "policyVersion", "category", "methodology", "portableSpecification", "products", "compatibility"],
  "properties": {
    "formatVersion": {"const": "stateport.terminology-policy/v1"},
    "policyVersion": {"const": 1},
    "category": {"$ref": "#/$defs/namedDefinition"},
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicName", "abbreviation", "legacyNames"],
      "properties": {
        "publicName": {"const": "State-Centric Engineering"},
        "abbreviation": {"const": "SCE"},
        "legacyNames": {"$ref": "#/$defs/nonEmptyUniqueStrings"}
      }
    },
    "portableSpecification": {"$ref": "#/$defs/namedAliases"},
    "products": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/product"}
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "publicMigrationStatus", "publicIntroductionText", "preserveUntilVersionedMigration", "allowedRemainingCategories", "completionGate", "legalTextRequiresSeparateReview", "archivesRemainFrozen"],
      "properties": {
        "strategy": {"const": "additive_aliases_before_physical_renames"},
        "publicMigrationStatus": {"enum": ["in_progress", "complete"]},
        "publicIntroductionText": {"const": "formerly called"},
        "preserveUntilVersionedMigration": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "allowedRemainingCategories": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["compatibility_alias", "machine_identifier", "historical_record", "legal_text", "archived_reference"]}
        },
        "completionGate": {"const": "no_unclassified_legacy_public_or_operator_usage"},
        "legalTextRequiresSeparateReview": {"const": true},
        "archivesRemainFrozen": {"const": true}
      }
    }
  },
  "$defs": {
    "nonEmptyUniqueStrings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "namedDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicName", "definition"],
      "properties": {
        "publicName": {"const": "Stateware"},
        "definition": {"type": "string", "minLength": 40, "maxLength": 512}
      }
    },
    "namedAliases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicName", "legacyNames"],
      "properties": {
        "publicName": {"const": "StateSpec"},
        "legacyNames": {"$ref": "#/$defs/nonEmptyUniqueStrings"}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicName", "legacyNames", "machineIdentifiers"],
      "properties": {
        "publicName": {"type": "string", "minLength": 2, "maxLength": 128},
        "legacyNames": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "machineIdentifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    }
  }
}
