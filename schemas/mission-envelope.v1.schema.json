{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.dev/schemas/mission-envelope.v1.schema.json",
  "title": "StatePort bounded mission envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "mission"],
  "properties": {
    "formatVersion": {"const": "stateport.mission-envelope/v1"},
    "mission": {"$ref": "#/$defs/mission"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "phase": {
      "enum": ["source_repair", "candidate_construction", "image_build", "signing", "qualification", "publication", "deployment", "owner_test", "process_control"]
    },
    "action": {
      "enum": ["heavy_operation", "candidate_construction", "image_build", "signing", "qualification", "publication", "deployment"]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changedPaths", "changedLines", "correctiveCycles", "reviewRepairCycles", "heavyOperations", "candidateBuilds", "contextCompactions"],
      "properties": {
        "changedPaths": {"type": "integer", "minimum": 0},
        "changedLines": {"type": "integer", "minimum": 0},
        "correctiveCycles": {"type": "integer", "minimum": 0},
        "reviewRepairCycles": {"type": "integer", "minimum": 0},
        "heavyOperations": {"type": "integer", "minimum": 0},
        "candidateBuilds": {"type": "integer", "minimum": 0},
        "contextCompactions": {"type": "integer", "minimum": 0}
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correctiveCycles", "reviewRepairCycles", "heavyOperations", "candidateBuilds", "contextCompactions", "materialFailures"],
      "properties": {
        "correctiveCycles": {"type": "integer", "minimum": 0},
        "reviewRepairCycles": {"type": "integer", "minimum": 0},
        "heavyOperations": {"type": "integer", "minimum": 0},
        "candidateBuilds": {"type": "integer", "minimum": 0},
        "contextCompactions": {"type": "integer", "minimum": 0},
        "materialFailures": {"type": "integer", "minimum": 0}
      }
    },
    "phaseAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "ownerDirectiveId"],
      "properties": {
        "phase": {"$ref": "#/$defs/phase"},
        "ownerDirectiveId": {"$ref": "#/$defs/identifier"}
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automaticExecution", "phaseTransition", "scopeExpansion", "technicalFailure", "handoff", "reviewCompletion"],
      "properties": {
        "automaticExecution": {"const": "current_phase_envelope_only"},
        "phaseTransition": {"const": "explicit_owner_directive_required"},
        "scopeExpansion": {"const": "explicit_owner_directive_required"},
        "technicalFailure": {"const": "one_bounded_correction_then_handoff"},
        "handoff": {"const": "mandatory_at_phase_boundary_budget_breach_second_compaction_or_second_material_failure"},
        "reviewCompletion": {"const": "one_repair_cycle_then_pass_or_quarantine"}
      }
    },
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stopLineCategories", "nonStopLineDisposition"],
      "properties": {
        "stopLineCategories": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 8,
          "maxItems": 8,
          "items": {"enum": ["canonical_data_loss", "destructive_or_external_mutation", "authority_bypass", "source_or_provenance_bypass", "credential_exposure", "arbitrary_untrusted_execution", "false_success", "declared_criterion_failure"]}
        },
        "nonStopLineDisposition": {"const": "defer_or_ignore_without_scope_expansion"}
      }
    },
    "rehearsalBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "preinstalledPackages", "extraRepositories", "extraBinaries", "extraRuntimeConfiguration", "permittedShims", "capabilityProvisioner"],
      "properties": {
        "os": {"const": "ubuntu-24.04"},
        "preinstalledPackages": {"const": "stock_image"},
        "extraRepositories": {"type": "array", "maxItems": 0},
        "extraBinaries": {"type": "array", "maxItems": 0},
        "extraRuntimeConfiguration": {"type": "array", "maxItems": 0},
        "permittedShims": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["wsl_kernel_identity_only", "windows_interop_identity_only"]}
        },
        "capabilityProvisioner": {"const": "exact_public_bootstrap_only"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "classification", "disposition", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "category": {"type": "string"},
        "classification": {"enum": ["S0", "S1", "S2", "S3"]},
        "disposition": {"enum": ["repair_or_quarantine", "deferred", "ignored"]},
        "status": {"enum": ["open", "repaired", "quarantined"]}
      }
    },
    "amendment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromRevision", "revision", "authorizedBy", "ownerDirectiveId", "reason", "changes"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "fromRevision": {"type": "integer", "minimum": 1},
        "revision": {"type": "integer", "minimum": 2},
        "authorizedBy": {"const": "owner"},
        "ownerDirectiveId": {"$ref": "#/$defs/identifier"},
        "reason": {"type": "string", "minLength": 1},
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "budgets": {"type": "object", "additionalProperties": false, "properties": {"changedPaths": {"type": "integer", "minimum": 0}, "changedLines": {"type": "integer", "minimum": 0}, "correctiveCycles": {"type": "integer", "minimum": 0}, "reviewRepairCycles": {"type": "integer", "minimum": 0}, "heavyOperations": {"type": "integer", "minimum": 0}, "candidateBuilds": {"type": "integer", "minimum": 0}, "contextCompactions": {"type": "integer", "minimum": 0}}},
            "phase": {"$ref": "#/$defs/phase"},
            "phaseAuthorization": {"$ref": "#/$defs/phaseAuthorization"},
            "allowedPaths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "allowedActions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/action"}},
            "forbiddenActions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/action"}},
            "acceptanceCriteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "acceptanceCriteriaDigest": {"$ref": "#/$defs/digest"},
            "status": {"enum": ["active", "handoff_required"]},
            "closureState": {"enum": ["open", "integrated", "quarantined", "rejected"]}
          }
        }
      }
    },
    "externalChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "baseDigest", "currentDigest", "changedLines"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "baseDigest": {"$ref": "#/$defs/digest"},
        "currentDigest": {"$ref": "#/$defs/digest"},
        "changedLines": {"type": "integer", "minimum": 0}
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "baseRevision", "revision", "ownerDirectiveId", "baseCommit", "objective", "phase", "phaseAuthorization", "acceptanceCriteria", "acceptanceCriteriaDigest", "allowedPaths", "budgets", "counters", "allowedActions", "forbiddenActions", "policies", "reviewPolicy", "reviewFindings", "rehearsalBaseline", "status", "closureState", "amendments"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "baseRevision": {"const": 1},
        "revision": {"type": "integer", "minimum": 1},
        "ownerDirectiveId": {"$ref": "#/$defs/identifier"},
        "baseCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "objective": {"type": "string", "minLength": 1},
        "phase": {"$ref": "#/$defs/phase"},
        "phaseAuthorization": {"$ref": "#/$defs/phaseAuthorization"},
        "acceptanceCriteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "acceptanceCriteriaDigest": {"$ref": "#/$defs/digest"},
        "allowedPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "budgets": {"$ref": "#/$defs/budgets"},
        "counters": {"$ref": "#/$defs/counters"},
        "allowedActions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/action"}},
        "forbiddenActions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/action"}},
        "policies": {"$ref": "#/$defs/policies"},
        "reviewPolicy": {"$ref": "#/$defs/reviewPolicy"},
        "reviewFindings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "rehearsalBaseline": {"$ref": "#/$defs/rehearsalBaseline"},
        "status": {"enum": ["active", "handoff_required"]},
        "closureState": {"enum": ["open", "integrated", "quarantined", "rejected"]},
        "amendments": {"type": "array", "items": {"$ref": "#/$defs/amendment"}},
        "externalChanges": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/externalChange"}}
      }
    }
  }
}
