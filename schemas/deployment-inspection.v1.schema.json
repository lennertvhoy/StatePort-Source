{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.local/schemas/deployment-inspection.v1.schema.json",
  "title": "StatePort read-only project deployment inspection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "source", "dirty", "detectedProjectTypes", "candidateServices", "buildContexts", "commands", "ports", "persistentPaths", "healthSignals", "secretReferences", "unsafeConstructs", "unknowns", "deterministicAssistedPlanningSupported", "sideEffects"],
  "properties": {
    "schema": {"const": "stateport.deployment-inspection/v1"},
    "project": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repositoryIdentity", "repositoryRoot", "projectPath", "commit", "treeDigest", "dirty", "dirtyDigest", "dirtyPolicy", "descriptorDigest", "origin", "inventory"],
      "properties": {
        "repositoryIdentity": {"$ref": "#/$defs/digest"},
        "repositoryRoot": {"type": "string", "minLength": 1, "pattern": "^/"},
        "projectPath": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "treeDigest": {"$ref": "#/$defs/digest"},
        "dirty": {"type": "boolean"},
        "dirtyDigest": {"$ref": "#/$defs/digest"},
        "dirtyPolicy": {"const": "refuse"},
        "descriptorDigest": {"$ref": "#/$defs/digest"},
        "origin": {"type": ["string", "null"]},
        "inventory": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "mode", "objectId", "contentDigest"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "mode": {"enum": ["100644", "100755"]},
              "objectId": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
              "contentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "dirty": {"type": "boolean"},
    "detectedProjectTypes": {"$ref": "#/$defs/stringList"},
    "candidateServices": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidateService"}
    },
    "buildContexts": {"$ref": "#/$defs/stringList"},
    "commands": {"$ref": "#/$defs/stringList"},
    "ports": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
    "persistentPaths": {"$ref": "#/$defs/stringList"},
    "healthSignals": {"$ref": "#/$defs/stringList"},
    "secretReferences": {"$ref": "#/$defs/stringList"},
    "unsafeConstructs": {"$ref": "#/$defs/stringList"},
    "unknowns": {"$ref": "#/$defs/stringList"},
    "deterministicAssistedPlanningSupported": {"type": "boolean"},
    "sideEffects": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runtimeId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?:\\.|(?!/)(?!\\./)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+)$"},
    "relativeFilePath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!\\.?\\.?$)(?!\\./)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"},
    "containerPath": {"type": "string", "minLength": 2, "maxLength": 256, "pattern": "^/(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"},
    "stringList": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "candidateService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "sourcePath", "build", "image", "command", "runtimeUser", "ports", "storage", "health", "secretReferences", "networks"],
      "properties": {
        "id": {"$ref": "#/$defs/runtimeId"},
        "source": {"enum": ["stateport_descriptor", "compose", "containerfile", "assisted_python", "assisted_node", "assisted_static"]},
        "sourcePath": {"$ref": "#/$defs/relativePath"},
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "context", "containerfile", "generated"],
          "properties": {
            "mode": {"enum": ["source", "image"]},
            "context": {"$ref": "#/$defs/relativePath"},
            "containerfile": {"$ref": "#/$defs/relativeFilePath"},
            "generated": {"type": "boolean"}
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "acceptedDigest"],
          "properties": {
            "reference": {"type": ["string", "null"], "pattern": "^[^ @]+@sha256:[0-9a-f]{64}$"},
            "acceptedDigest": {"type": "null"}
          }
        },
        "command": {"$ref": "#/$defs/argv"},
        "runtimeUser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "uid", "gid"],
          "properties": {
            "mode": {"const": "nonroot"},
            "uid": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "gid": {"type": "integer", "minimum": 1, "maximum": 2147483647}
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "containerPort", "hostAddress", "hostPort"],
            "properties": {
              "name": {"$ref": "#/$defs/runtimeId"},
              "containerPort": {"type": "integer", "minimum": 1, "maximum": 65535},
              "hostAddress": {"enum": ["127.0.0.1", "::1"]},
              "hostPort": {"type": "integer", "minimum": 0, "maximum": 65535}
            }
          }
        },
        "storage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "mountPath", "persistence"],
            "properties": {
              "id": {"$ref": "#/$defs/runtimeId"},
              "mountPath": {"$ref": "#/$defs/containerPath"},
              "persistence": {"enum": ["ephemeral", "retained", "backup_required", "externally_managed"]}
            }
          }
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "portName", "command", "intervalSeconds", "timeoutSeconds", "startPeriodSeconds"],
          "properties": {
            "type": {"enum": ["http", "command"]},
            "path": {"type": ["string", "null"]},
            "portName": {"type": ["string", "null"]},
            "command": {"$ref": "#/$defs/argv"},
            "intervalSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
            "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
            "startPeriodSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}
          }
        },
        "secretReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^secret-broker://"}
        },
        "networks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/runtimeId"}
        }
      }
    }
  }
}
