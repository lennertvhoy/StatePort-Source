{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.local/schemas/stable-host-service-plan.v1.schema.json",
  "title": "StatePort stable host service materialization plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "releaseId", "targetId", "topologyDigest", "lifecycleRoot", "replacementPolicy", "services", "bundleDigest", "planDigest"],
  "properties": {
    "schema": {"const": "stateport.stable-host-service-plan/v1"},
    "releaseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "targetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "topologyDigest": {"$ref": "#/$defs/digest"},
    "lifecycleRoot": {"const": "stable-out-of-revision-quadlet-root"},
    "replacementPolicy": {"const": "explicit-compatible-host-update-only"},
    "services": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["serviceId", "imageId", "imageReference", "imageDigest", "quadletOwner", "runAsUser", "engineAccess", "socket", "ports", "writableVolumes", "resources", "logging", "health", "updateCompatibility", "unitPath", "activation"],
        "properties": {
          "serviceId": {"type": "string", "pattern": "^stateport-[a-z0-9][a-z0-9-]{1,62}$"},
          "imageId": {"type": "string", "pattern": "^stateport-[a-z0-9][a-z0-9-]{1,62}$"},
          "imageReference": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*(?::[0-9]{1,5})?(?:/[a-z0-9][a-z0-9._-]*)+@sha256:[0-9a-f]{64}$"},
          "imageDigest": {"$ref": "#/$defs/digest"},
          "quadletOwner": {"enum": ["stateport-control", "stateport-exec"]},
          "runAsUser": {"type": "integer", "minimum": 1, "maximum": 4294967294},
          "engineAccess": {"type": ["object", "null"]},
          "socket": {"type": ["object", "null"]},
          "ports": {"type": "array", "maxItems": 16},
          "writableVolumes": {"type": "array", "maxItems": 16},
          "resources": {"type": "object"},
          "logging": {"type": "object"},
          "health": {"type": "object"},
          "updateCompatibility": {"type": "object"},
          "unitPath": {"type": "string", "pattern": "^host/(?:stateport-control|stateport-exec)/stateport-[a-z0-9-]+\\.container$"},
          "activation": {"const": "enabled-by-explicit-host-plan-only"}
        }
      }
    },
    "bundleDigest": {"$ref": "#/$defs/digest"},
    "planDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
