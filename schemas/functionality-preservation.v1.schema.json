{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.dev/schemas/functionality-preservation.v1.schema.json",
  "title": "FunctionalityPreservationManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "scope", "uiRoutes", "userControls", "apiOperations", "capabilities", "legacyAliases"],
  "properties": {
    "formatVersion": {"const": "stateport.functionality-preservation/v1"},
    "scope": {"const": "application-first-shell-foundation"},
    "uiRoutes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/surface"}},
    "userControls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/surface"}},
    "apiOperations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/api"}},
    "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/surface"}},
    "legacyAliases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/alias"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,159}$"},
    "classification": {"enum": ["application-native", "conversation", "advanced-control", "workbench-capability", "platform-operation", "deprecated-with-explicit-replacement"]},
    "status": {"enum": ["preserved", "repositioned", "foundation", "deprecated"]},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "contains"],
      "properties": {"file": {"type": "string", "minLength": 1}, "contains": {"type": "string", "minLength": 1}}
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "classification", "status", "migrationBehavior", "test", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "classification": {"$ref": "#/$defs/classification"},
        "status": {"enum": ["preserved", "repositioned", "foundation", "deprecated", "gap"]},
        "migrationBehavior": {"type": "string", "minLength": 1, "maxLength": 240},
        "replacement": {"type": "string", "minLength": 1, "maxLength": 160},
        "remainingGap": {"type": "string", "minLength": 1, "maxLength": 240},
        "test": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "deprecated"}}},
          "then": {
            "required": ["replacement"],
            "properties": {"classification": {"const": "deprecated-with-explicit-replacement"}}
          }
        },
        {
          "if": {"properties": {"status": {"const": "gap"}}},
          "then": {
            "required": ["remainingGap"],
            "properties": {
              "classification": {
                "enum": ["application-native", "conversation", "advanced-control", "workbench-capability", "platform-operation"]
              }
            },
            "not": {"required": ["replacement"]}
          },
          "else": {"not": {"required": ["remainingGap"]}}
        }
      ]
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "path", "classification", "status", "migrationBehavior", "test", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "method": {"enum": ["GET", "POST"]}, "path": {"type": "string", "pattern": "^/(?:session|health|v1/)[A-Za-z0-9{}:/._-]*$"},
        "classification": {"$ref": "#/$defs/classification"}, "status": {"$ref": "#/$defs/status"}, "migrationBehavior": {"type": "string", "minLength": 1, "maxLength": 240},
        "replacement": {"type": "string", "minLength": 1, "maxLength": 160}, "test": {"type": "string", "minLength": 1}, "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "alias", "canonical", "classification", "status", "migrationBehavior", "test", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "alias": {"type": "string", "minLength": 1}, "canonical": {"type": "string", "minLength": 1},
        "classification": {"$ref": "#/$defs/classification"}, "status": {"const": "preserved"}, "migrationBehavior": {"type": "string", "minLength": 1, "maxLength": 240},
        "test": {"type": "string", "minLength": 1}, "evidence": {"$ref": "#/$defs/evidence"}
      }
    }
  }
}
