{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.local/schemas/deployment-receipt.v1.schema.json",
  "title": "StatePort deployment transition receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receiptId", "deploymentId", "sequence", "event", "actor", "createdAt", "data", "previousReceiptDigest", "receiptDigest"],
  "properties": {
    "schema": {"const": "stateport.deployment-receipt/v1"},
    "receiptId": {"type": "string", "pattern": "^receipt_[A-Za-z0-9._-]+$"},
    "deploymentId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "event": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "actor": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "createdAt": {"$ref": "#/$defs/timestamp"},
    "data": {"type": "object"},
    "previousReceiptDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
