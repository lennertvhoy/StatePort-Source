{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.local/schemas/deployment.v1.schema.json",
  "title": "StatePort governed deployment specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "metadata", "source", "target", "services", "networks", "authority", "policy"],
  "properties": {
    "schema": {"const": "stateport.deployment/v1"},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["deploymentId", "applicationId", "name"],
      "properties": {
        "deploymentId": {"$ref": "#/$defs/id"},
        "applicationId": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repositoryIdentity", "repositoryRoot", "projectPath", "commit", "treeDigest", "dirty", "dirtyDigest", "dirtyPolicy", "descriptorDigest"],
      "properties": {
        "repositoryIdentity": {"$ref": "#/$defs/digestOrNull"},
        "repositoryRoot": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096, "pattern": "^/"},
        "projectPath": {"$ref": "#/$defs/relativePath"},
        "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
        "treeDigest": {"$ref": "#/$defs/digestOrNull"},
        "dirty": {"enum": [false, null]},
        "dirtyDigest": {"$ref": "#/$defs/digestOrNull"},
        "dirtyPolicy": {"const": "refuse"},
        "descriptorDigest": {"$ref": "#/$defs/digestOrNull"}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "targetId", "architecture", "identityDigest"],
      "properties": {
        "adapter": {"const": "rootless-podman-local"},
        "targetId": {"const": "local"},
        "architecture": {"const": "linux-amd64"},
        "identityDigest": {"$ref": "#/$defs/digestOrNull"}
      }
    },
    "services": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/service"}
    },
    "networks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "public"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "public": {"const": false}}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["grantId", "requireApproval", "automaticWithReceipt"],
      "properties": {
        "grantId": {"anyOf": [{"$ref": "#/$defs/grantId"}, {"type": "null"}]},
        "requireApproval": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "contains": {"const": "first_apply"},
          "items": {"enum": ["first_apply", "non_loopback_port", "secret_binding", "destructive_replacement", "data_purge"]}
        },
        "automaticWithReceipt": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["health_check", "restart", "log_collection", "observe", "remove_runtime_preserve_data"]}
        }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinaryRemovePreservesData", "rollbackOnFailedHealth"],
      "properties": {
        "ordinaryRemovePreservesData": {"const": true},
        "rollbackOnFailedHealth": {"const": true}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "grantId": {"type": "string", "pattern": "^grant_[A-Za-z0-9][A-Za-z0-9._-]{2,95}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digestOrNull": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?:\\.|(?!/)(?!\\./)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+)$"},
    "relativeFilePath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!\\.?\\.?$)(?!\\./)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"},
    "containerPath": {"type": "string", "minLength": 2, "maxLength": 256, "pattern": "^/(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"},
    "storagePath": {"type": "string", "minLength": 2, "maxLength": 256, "pattern": "^/(?!/)(?!(?:etc|var|run|home|proc|sys|dev|usr|boot|root)(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"},
    "nonSecretString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        {"not": {"pattern": "\\u0000"}},
        {"not": {"pattern": "(?:-----BEGIN (?:RSA |OPENSSH |EC )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9_-]{20,}|AKIA[A-Z0-9]{16}|STATEPORT_TEST_SECRET_[A-Za-z0-9_-]+)"}}
      ]
    },
    "argv": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonSecretString"}},
    "service": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourcePath", "build", "image", "runtime", "ports", "health", "resources", "storage", "secrets", "environment", "networks"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "sourcePath": {"$ref": "#/$defs/relativePath"},
        "build": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "context", "containerfile", "generated"],
          "properties": {
            "mode": {"enum": ["source", "image"]},
            "context": {"$ref": "#/$defs/relativePath"},
            "containerfile": {"$ref": "#/$defs/relativeFilePath"},
            "generated": {"type": "boolean"}
          }
        },
        "image": {
          "type": "object", "additionalProperties": false,
          "required": ["reference", "acceptedDigest"],
          "properties": {
            "reference": {"type": ["string", "null"], "pattern": "^[^ @]+@sha256:[0-9a-f]{64}$"},
            "acceptedDigest": {"type": "null"}
          }
        },
        "runtime": {
          "type": "object", "additionalProperties": false,
          "required": ["command", "workdir", "user", "readOnlyRoot"],
          "properties": {
            "command": {"$ref": "#/$defs/argv"},
            "workdir": {"$ref": "#/$defs/containerPath"},
            "user": {
              "type": "object", "additionalProperties": false,
              "required": ["mode", "uid", "gid"],
              "properties": {
                "mode": {"const": "nonroot"},
                "uid": {"type": "integer", "minimum": 1, "maximum": 2147483647},
                "gid": {"type": "integer", "minimum": 1, "maximum": 2147483647}
              }
            },
            "readOnlyRoot": {"const": true}
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "containerPort", "hostAddress", "hostPort"],
            "properties": {
              "name": {"$ref": "#/$defs/id"},
              "containerPort": {"type": "integer", "minimum": 1, "maximum": 65535},
              "hostAddress": {"enum": ["127.0.0.1", "::1"]},
              "hostPort": {"type": "integer", "minimum": 0, "maximum": 65535}
            }
          }
        },
        "health": {
          "type": "object", "additionalProperties": false,
          "required": ["type", "path", "portName", "command", "intervalSeconds", "timeoutSeconds", "startPeriodSeconds"],
          "properties": {
            "type": {"enum": ["http", "command"]},
            "path": {"type": ["string", "null"]},
            "portName": {"type": ["string", "null"]},
            "command": {"$ref": "#/$defs/argv"},
            "intervalSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
            "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
            "startPeriodSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}
          }
        },
        "resources": {
          "type": "object", "additionalProperties": false,
          "required": ["memoryLimit", "cpuLimit", "pidsLimit"],
          "properties": {
            "memoryLimit": {"type": "string", "pattern": "^[1-9][0-9]*[kKmMgG]?$"},
            "cpuLimit": {"type": "number", "exclusiveMinimum": 0, "maximum": 64},
            "pidsLimit": {"type": "integer", "minimum": 1, "maximum": 32768}
          }
        },
        "storage": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "mountPath", "persistence"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "mountPath": {"$ref": "#/$defs/storagePath"},
              "persistence": {"enum": ["ephemeral", "retained", "backup_required", "externally_managed"]}
            }
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "binding"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "binding": {
                "type": "string",
                "maxLength": 272,
                "pattern": "^secret-broker://[A-Za-z0-9](?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{0,255}$",
                "not": {"pattern": "(?:-----BEGIN (?:RSA |OPENSSH |EC )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9_-]{20,}|AKIA[A-Z0-9]{16}|STATEPORT_TEST_SECRET_[A-Za-z0-9_-]+)"}
              }
            }
          }
        },
        "environment": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]{0,127}$",
            "not": {"pattern": "(?:SECRET|TOKEN|PASSWORD|CREDENTIAL|API[_-]?KEY)"}
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096,
            "allOf": [
              {"not": {"pattern": "\\u0000"}},
              {"not": {"pattern": "(?:-----BEGIN (?:RSA |OPENSSH |EC )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9_-]{20,}|AKIA[A-Z0-9]{16}|STATEPORT_TEST_SECRET_[A-Za-z0-9_-]+)"}}
            ]
          }
        },
        "networks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Each identifier must reference a network declared by this deployment; runtime validation enforces this cross-reference.",
          "items": {"$ref": "#/$defs/id"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "build": {"properties": {"mode": {"const": "source"}}}
            }
          },
          "then": {
            "properties": {
              "image": {"properties": {"reference": {"type": "null"}}}
            }
          },
          "else": {
            "properties": {
              "image": {"properties": {"reference": {"type": "string"}}}
            }
          }
        },
        {
          "if": {
            "properties": {
              "health": {"properties": {"type": {"const": "http"}}}
            }
          },
          "then": {
            "properties": {
              "health": {
                "properties": {
                  "path": {"type": "string", "pattern": "^/"},
                  "portName": {
                    "$ref": "#/$defs/id",
                    "description": "Must reference a port declared by this service; runtime validation enforces this cross-reference."
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "health": {
                "properties": {
                  "path": {"type": "null"},
                  "portName": {"type": "null"}
                }
              }
            }
          }
        }
      ]
    }
  }
}
