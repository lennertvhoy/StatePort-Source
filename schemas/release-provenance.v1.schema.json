{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.invalid/schemas/release-provenance.v1.schema.json",
  "title": "StatePort SLSA-aligned release provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "subject": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 512},
          "digest": {
            "type": "object", "additionalProperties": false,
            "required": ["sha256"],
            "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
          }
        }
      }
    },
    "predicateType": {"const": "https://slsa.dev/provenance/v1"},
    "predicate": {
      "type": "object", "additionalProperties": false,
      "required": ["buildDefinition", "runDetails"],
      "properties": {
        "buildDefinition": {
          "type": "object", "additionalProperties": false,
          "required": ["buildType", "externalParameters", "internalParameters", "resolvedDependencies"],
          "properties": {
            "buildType": {"const": "https://stateport.invalid/buildtypes/oci/v1"},
            "externalParameters": {
              "type": "object", "additionalProperties": false,
              "required": ["sourceRepository", "sourceCommit", "sourceTree", "publicSnapshotCommit", "publicSnapshotTree", "platform", "dockerfile"],
              "properties": {
                "sourceRepository": {"type": "string", "pattern": "^https://[^\\s?#]+$"},
                "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "sourceTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "publicSnapshotCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "publicSnapshotTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "platform": {"const": "linux/amd64"},
                "dockerfile": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}
              }
            },
            "internalParameters": {
              "type": "object", "additionalProperties": false,
              "required": ["sourceDateEpoch", "networkMode"],
              "properties": {
                "sourceDateEpoch": {"type": "integer", "minimum": 0},
                "networkMode": {"enum": ["none", "dependency-fetch-only"]}
              }
            },
            "resolvedDependencies": {
              "type": "array", "minItems": 1, "maxItems": 512,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["uri", "digest"],
                "properties": {
                  "uri": {"type": "string", "minLength": 1, "maxLength": 2048},
                  "digest": {
                    "type": "object", "additionalProperties": false,
                    "required": ["sha256"],
                    "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
                  }
                }
              }
            }
          }
        },
        "runDetails": {
          "type": "object", "additionalProperties": false,
          "required": ["builder", "metadata", "byproducts"],
          "properties": {
            "builder": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "version", "executableDigest", "descriptorDigest", "artifactUri", "artifactDigest"],
              "properties": {
                "id": {"type": "string", "minLength": 1, "maxLength": 512},
                "version": {"type": "string", "minLength": 1, "maxLength": 128},
                "executableDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "descriptorDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "artifactUri": {"type": "string", "minLength": 1, "maxLength": 2048},
                "artifactDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              }
            },
            "metadata": {
              "type": "object", "additionalProperties": false,
              "required": ["invocationId", "startedOn", "finishedOn"],
              "properties": {
                "invocationId": {"type": "string", "minLength": 1, "maxLength": 256},
                "startedOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
                "finishedOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
              }
            },
            "byproducts": {
              "type": "array", "maxItems": 64,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["name", "digest"],
                "properties": {
                  "name": {"type": "string", "minLength": 1, "maxLength": 256},
                  "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
                }
              }
            }
          }
        }
      }
    }
  }
}
