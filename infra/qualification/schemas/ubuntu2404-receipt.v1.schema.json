{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.invalid/schemas/ubuntu2404-receipt.v1.schema.json",
  "title": "StatePort Ubuntu 24.04 qualification receipt v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "evidenceClass", "candidate", "guest", "executionHostReceipt", "stages", "cleanup"],
  "properties": {
    "schema": {"const": "stateport.qualification.ubuntu2404-receipt/v1"}, "evidenceClass": {"enum": ["real_guest", "fixture"]}, "candidate": {"$ref": "#/$defs/candidate"},
    "guest": {"type": "object", "additionalProperties": false, "required": ["guestId", "distribution", "version", "isolated", "sourceCheckoutPresent", "preExistingStatePortImages", "preExistingStatePortServices", "machineIdDigest", "bootIdDigest", "guestIdentityDigest", "hostFacts"], "properties": {"guestId": {"type": "string"}, "distribution": {"const": "ubuntu"}, "version": {"const": "24.04"}, "isolated": {"const": true}, "sourceCheckoutPresent": {"const": false}, "preExistingStatePortImages": {"const": false}, "preExistingStatePortServices": {"const": false}, "machineIdDigest": {"$ref": "#/$defs/digest"}, "bootIdDigest": {"$ref": "#/$defs/digest"}, "guestIdentityDigest": {"$ref": "#/$defs/digest"}, "hostFacts": {"$ref": "#/$defs/hostFacts"}}},
    "executionHostReceipt": {"type": "object", "additionalProperties": false, "required": ["digest", "imageId", "sourceCommit", "sourceTree", "imageDigest", "installerDigest", "protocolHealth"], "properties": {"digest": {"$ref": "#/$defs/digest"}, "imageId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "sourceCommit": {"$ref": "#/$defs/sha1"}, "sourceTree": {"$ref": "#/$defs/sha1"}, "imageDigest": {"$ref": "#/$defs/digest"}, "installerDigest": {"$ref": "#/$defs/digest"}, "protocolHealth": {"type": "object", "additionalProperties": false, "required": ["describeCapabilities", "result", "receiptDigest"], "properties": {"describeCapabilities": {"const": true}, "result": {"const": "passed"}, "receiptDigest": {"$ref": "#/$defs/digest"}}}}},
    "stages": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["stageId", "result", "receiptDigest"], "properties": {"stageId": {"enum": ["capability_evaluation", "provisioning", "install", "protocol_health", "persistence_reboot", "reinstall_convergence", "cleanup"]}, "result": {"const": "passed"}, "receiptDigest": {"$ref": "#/$defs/digest"}}}},
    "cleanup": {"type": "object", "additionalProperties": false, "required": ["result", "removedImages", "removedServices", "removedAccounts", "removedGroups", "removedSubordinateMappings", "removedRootArtifacts"], "properties": {"result": {"const": "passed"}, "removedImages": {"const": true}, "removedServices": {"const": true}, "removedAccounts": {"const": true}, "removedGroups": {"const": true}, "removedSubordinateMappings": {"const": true}, "removedRootArtifacts": {"const": true}}}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["releaseId", "version", "targetId", "releaseIndexDigest", "signedPayloadDigest", "sourceCommit", "sourceTree", "publicSource", "imageDigests", "installerDigest"], "properties": {"releaseId": {"type": "string"}, "version": {"type": "string"}, "targetId": {"const": "linux-amd64-rootless-podman-quadlet"}, "releaseIndexDigest": {"$ref": "#/$defs/digest"}, "signedPayloadDigest": {"$ref": "#/$defs/digest"}, "sourceCommit": {"$ref": "#/$defs/sha1"}, "sourceTree": {"$ref": "#/$defs/sha1"}, "installerDigest": {"$ref": "#/$defs/digest"}, "publicSource": {"type": "object", "additionalProperties": false, "required": ["authorityUrl", "ref", "commit", "tree"], "properties": {"authorityUrl": {"type": "string", "pattern": "^https://[^\\s?#]+$"}, "ref": {"type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+$"}, "commit": {"$ref": "#/$defs/sha1"}, "tree": {"$ref": "#/$defs/sha1"}}}, "imageDigests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}}},
    "hostFacts": {"type": "object", "additionalProperties": false, "required": ["kernel", "kernelRelease", "wslDetected", "architecture", "cgroupVersion", "podmanVersion", "podmanVersionMeetsFloor", "rootlessPodman", "quadlet", "systemdUserServices", "subuidMapping", "subgidMapping", "eligible"], "properties": {"kernel": {"const": "Linux"}, "kernelRelease": {"type": "string", "minLength": 1}, "wslDetected": {"const": false}, "architecture": {"enum": ["x86_64", "amd64"]}, "cgroupVersion": {"const": "v2"}, "podmanVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"}, "podmanVersionMeetsFloor": {"const": true}, "rootlessPodman": {"const": true}, "quadlet": {"const": true}, "systemdUserServices": {"const": true}, "subuidMapping": {"const": true}, "subgidMapping": {"const": true}, "eligible": {"const": true}}}
  }
}
