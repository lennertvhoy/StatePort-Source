{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.invalid/schemas/qualification-stage-receipt.v1.schema.json",
  "title": "StatePort qualification stage receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "guestId", "stageId", "candidate", "evidenceClass", "observedAt", "result", "facts"],
  "properties": {
    "schema": {"const": "stateport.qualification-stage-receipt/v1"},
    "guestId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
    "stageId": {"enum": ["guest_identity", "capability_facts", "release_verification", "provisioning", "install", "protocol_health", "representative_app", "backup_export", "restart_reread", "update_rollback", "uninstall_purge", "final_durable_state"]},
    "candidate": {"$ref": "#/$defs/candidate"},
    "evidenceClass": {"const": "real_guest"},
    "observedAt": {"$ref": "#/$defs/timestamp"},
    "result": {"enum": ["passed", "failed", "not_executed"]},
    "facts": {"type": "object"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "version", "targetId", "releaseIndexUri", "releaseIndexDigest", "signedPayloadDigest", "sourceCommit", "sourceTree", "imageDigests"],
      "properties": {
        "releaseId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "targetId": {"const": "linux-amd64-rootless-podman-quadlet"},
        "releaseIndexUri": {"type": "string", "minLength": 1},
        "releaseIndexDigest": {"$ref": "#/$defs/digest"},
        "signedPayloadDigest": {"$ref": "#/$defs/digest"},
        "sourceCommit": {"$ref": "#/$defs/sha1"},
        "sourceTree": {"$ref": "#/$defs/sha1"},
        "imageDigests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}
      }
    }
  }
}
