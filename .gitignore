.venv/
node_modules/
dist/
build/
*.log
evidence/**/audits/.last-audit-hash
.DS_Store
.idea/
.vscode/
*.swp
*~
.stateport/
.playwright-mcp/
.playwright-cli/
output/playwright/
/release-output/
/docs/audit/
/.commandcode/
/.stateport-local/
/apps/web/test-results/
/apps/web/playwright-report/
.pytest_cache/
*.sqlite3-wal
*.sqlite3-shm
.venv-test/

# Gate report captures written next to STATE.yaml by an external wrapper.
# They are build artefacts, never tracked, and the release image build requires a
# clean tree INCLUDING untracked paths (build_release_images.py uses
# `git status --porcelain=v1 --untracked-files=all`), so an untracked capture would
# otherwise block the release build on the gate own output.
STATE.yaml.gateout.*
