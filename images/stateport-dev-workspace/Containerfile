ARG STATEPORT_PROVIDER_IMAGE=stateport-provider-empty
FROM docker.io/library/ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90 AS workspace

ARG STATEPORT_BUILD_SOURCE_COMMIT=unknown
ARG STATEPORT_BUILD_SOURCE_TREE=unknown
ARG STATEPORT_BUILD_SOURCE_REF=unknown
ARG STATEPORT_BUILD_SOURCE_DIRTY=true
ARG STATEPORT_BUILD_SOURCE_DATE_EPOCH=unknown
ARG STATEPORT_BUILD_VERSION=0.0.0-unknown
ARG STATEPORT_BUILD_CREATED=1970-01-01T00:00:00Z
ARG STATEPORT_BUILD_ADAPTER=unknown
LABEL org.opencontainers.image.title="StatePort Developer Workspace" \
      org.opencontainers.image.source="https://github.com/lennertvhoy/StatePort" \
      org.opencontainers.image.revision="${STATEPORT_BUILD_SOURCE_COMMIT}" \
      org.opencontainers.image.version="${STATEPORT_BUILD_VERSION}" \
      org.opencontainers.image.created="${STATEPORT_BUILD_CREATED}" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      io.stateport.source.tree="${STATEPORT_BUILD_SOURCE_TREE}" \
      org.opencontainers.image.ref.name="${STATEPORT_BUILD_SOURCE_REF}" \
      io.stateport.source.dirty="${STATEPORT_BUILD_SOURCE_DIRTY}" \
      io.stateport.source-date-epoch="${STATEPORT_BUILD_SOURCE_DATE_EPOCH}" \
      io.stateport.build.adapter="${STATEPORT_BUILD_ADAPTER}" \
      io.stateport.image.role="developer-workspace" \
      io.stateport.credentials="operator-volume-only"

# Ubuntu's minimal base intentionally omits TLS roots. Bootstrap the exact
# signed ca-certificates package from the base's signed archive, then replace
# live sources with the fixed 2026-08-01 Canonical snapshot before installing
# every other exact package.
# Package-manager byproducts (apt/dpkg/alternatives logs and the ldconfig
# aux-cache) embed wall-clock timestamps and would break OCI two-build digest
# reproducibility, and they carry no runtime value in an image; remove them
# at the end of every package step.
RUN printf '%s\n' 'Acquire::Retries "3";' 'Acquire::http::Timeout "30";' \
      'Acquire::https::Timeout "30";' 'APT::Update::Error-Mode "any";' \
      > /etc/apt/apt.conf.d/80-stateport-build-transport \
    && apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates=20260601~24.04.1 \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /var/log/apt/history.log /var/log/apt/term.log /var/log/apt/eipp.log.xz \
      /var/log/dpkg.log /var/log/alternatives.log /var/cache/ldconfig/aux-cache
COPY images/stateport-dev-workspace/ubuntu-snapshot.sources /etc/apt/sources.list.d/ubuntu.sources
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
      bash=5.2.21-2ubuntu4 \
      bat=0.24.0-1build1 \
      build-essential=12.10ubuntu1 \
      curl=8.5.0-2ubuntu10.11 \
      dnsutils=1:9.18.39-0ubuntu0.24.04.5 \
      eza=0.18.2-1 \
      fd-find=9.0.0-1 \
      git=1:2.43.0-1ubuntu7.3 \
      iproute2=6.1.0-1ubuntu6.4 \
      iputils-ping=3:20240117-1ubuntu0.1 \
      jq=1.7.1-3ubuntu0.24.04.2 \
      less=590-2ubuntu2.1 \
      locales=2.39-0ubuntu8.8 \
      netcat-openbsd=1.226-1ubuntu2 \
      openssh-client=1:9.6p1-3ubuntu13.18 \
      procps=2:4.0.4-4ubuntu3.2 \
      python3=3.12.3-0ubuntu2.1 \
      python3-pip=24.0+dfsg-1ubuntu1.3 \
      python3-venv=3.12.3-0ubuntu2.1 \
      ripgrep=14.1.0-1 \
      tmux=3.4-1ubuntu0.1 \
      unzip=6.0-28ubuntu4.1 \
      xz-utils=5.6.1+really5.4.5-1ubuntu0.3 \
      yq=3.1.0-3 \
      zip=3.0-13ubuntu0.2 \
      zsh=5.9-6ubuntu2 \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /var/log/apt/history.log /var/log/apt/term.log /var/log/apt/eipp.log.xz \
      /var/log/dpkg.log /var/log/alternatives.log /var/cache/ldconfig/aux-cache \
    && rm /etc/apt/apt.conf.d/80-stateport-build-transport \
    && groupadd --gid 10001 stateport \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/stateport --shell /bin/bash stateport \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && ln -s /usr/bin/batcat /usr/local/bin/bat \
    && mkdir -p /workspace /home/stateport/.codex \
    && chown -R 10001:10001 /workspace /home/stateport

# Build gh and fzf from exact release commits with pinned Go 1.26.7, preserving
# upstream version metadata. Sources, toolchain, and Node assets are
# digest-verified; build-only bytes and caches are removed in the same layer.
# The optional github_token build secret only unlocks GitHub transport for the
# pinned public clones; every fetched byte is still verified against the exact
# pinned SHA-256 digest below, so no secret ever becomes release content.
RUN --mount=type=secret,id=github_token \
    if [ -r /run/secrets/github_token ]; then \
      git config --global credential.https://github.com.helper '!f() { echo "username=x-access-token"; echo "password=$(cat /run/secrets/github_token)"; }; f'; \
    fi \
    && curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error \
      -o /tmp/go1.26.7.linux-amd64.tar.gz \
      https://dl.google.com/go/go1.26.7.linux-amd64.tar.gz \
    && echo "ffb5f8de10c62550dfddab66b36b57030721e0a44a3218e9e1181d7b59f121ca  /tmp/go1.26.7.linux-amd64.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/go1.26.7.linux-amd64.tar.gz -C /usr/local --no-same-owner \
    && git clone --filter=blob:none --no-checkout --quiet https://github.com/cli/cli.git /tmp/cli-source \
    && git -C /tmp/cli-source fetch --quiet --depth 1 origin a255baf71d13fe5947a4eb7ad521ffd412d64cee \
    && git -C /tmp/cli-source checkout -q --detach FETCH_HEAD \
    && git -C /tmp/cli-source archive --format=tar --prefix=cli-a255baf71d13fe5947a4eb7ad521ffd412d64cee/ HEAD > /tmp/gh-a255baf7.tar \
    && echo "8774dabd7d3d1a0ee6c8b8231f659d6b8d64a8da8803d63e2a95fba66f2f518f  /tmp/gh-a255baf7.tar" | sha256sum -c - \
    && git clone --filter=blob:none --no-checkout --quiet https://github.com/junegunn/fzf.git /tmp/fzf-source \
    && git -C /tmp/fzf-source fetch --quiet --depth 1 origin 3337be9d450cd349e99273a2d3985ceaf5f3753f \
    && git -C /tmp/fzf-source checkout -q --detach FETCH_HEAD \
    && git -C /tmp/fzf-source archive --format=tar --prefix=fzf-3337be9d450cd349e99273a2d3985ceaf5f3753f/ HEAD > /tmp/fzf-3337be9d.tar \
    && echo "8d8dd8e1ddb33aad685713be4cdae48030ce4ecd57f8558db242aafe4f81be8e  /tmp/fzf-3337be9d.tar" | sha256sum -c - \
    && mkdir -p /tmp/go-tool-build \
    && tar -xf /tmp/gh-a255baf7.tar -C /tmp/go-tool-build --no-same-owner \
    && tar -xf /tmp/fzf-3337be9d.tar -C /tmp/go-tool-build --no-same-owner \
    && cd /tmp/go-tool-build/cli-a255baf71d13fe5947a4eb7ad521ffd412d64cee \
    && GOTOOLCHAIN=local CGO_ENABLED=0 GOOS=linux GOARCH=amd64 /usr/local/go/bin/go build \
      -mod=readonly -trimpath -buildvcs=false \
      -ldflags "-s -w -X github.com/cli/cli/v2/internal/build.Version=2.98.0 -X github.com/cli/cli/v2/internal/build.Date=2026-08-20" \
      -o /usr/local/bin/gh ./cmd/gh \
    && cd /tmp/go-tool-build/fzf-3337be9d450cd349e99273a2d3985ceaf5f3753f \
    && GOTOOLCHAIN=local CGO_ENABLED=0 GOOS=linux GOARCH=amd64 /usr/local/go/bin/go build \
      -a -mod=readonly -trimpath -buildvcs=false \
      -ldflags "-s -w -X main.version=0.74.2 -X main.revision=3337be9d" \
      -o /usr/local/bin/fzf . \
    && /usr/local/go/bin/go version -m /usr/local/bin/gh | grep -F "go1.26.7" \
    && /usr/local/go/bin/go version -m /usr/local/bin/fzf | grep -F "go1.26.7" \
    && grep -aqF "golang.org/x/mod/sumdb/note" /usr/local/bin/gh \
    && ! grep -aqE 'golang\.org/x/mod/(sumdb\.Client|sumdb/client|sumdb/tlog|tlog\.)' /usr/local/bin/gh \
    && gh --version | grep -Fx "gh version 2.98.0 (2026-08-20)" \
    && fzf --version | grep -Fx "0.74.2 (3337be9d)" \
    && curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error \
      -o /tmp/node-v22.23.2-linux-x64.tar.gz \
      https://nodejs.org/dist/v22.23.2/node-v22.23.2-linux-x64.tar.gz \
    && echo "b294a556e639d64338823920e5866c21c02741742d2e1529ee1a225c1ec9252a  /tmp/node-v22.23.2-linux-x64.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/node-v22.23.2-linux-x64.tar.gz -C /usr/local --no-same-owner \
      --strip-components=1 \
    && rm -rf /usr/local/go /tmp/go-tool-build /tmp/cli-source /tmp/fzf-source /root/go /root/.cache/go-build \
      /root/.config/go /root/.local/state/gh /root/.gitconfig \
    && rm -f /tmp/go1.26.7.linux-amd64.tar.gz /tmp/gh-a255baf7.tar \
      /tmp/fzf-3337be9d.tar /tmp/node-v22.23.2-linux-x64.tar.gz

# Node 22.23.2 bundles npm 11 whose own dependency tree carries known
# vulnerable packages (tar 7.5.11, sigstore 3.1.0, picomatch 4.0.3,
# brace-expansion 2.0.2). npm is a user-facing tool in this developer image,
# so it is upgraded in place from the pinned upstream npm 12.0.2 bundle; that
# bundle still carries brace-expansion 5.0.7 and ip-address 10.2.0, so both
# packages are overlaid with their pinned fixed releases. Assets are fetched
# over TLS and verified against exact pinned SHA-256 digests recorded in
# config/container-build-inputs.yaml; any mismatch fails the build.
RUN curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error \
      -o /tmp/npm-12.0.2.tgz \
      https://registry.npmjs.org/npm/-/npm-12.0.2.tgz \
    && echo "5dbb86c71d07a1957f2e90734092dd6a58bdcd9ebc2d8d41ca1c6e6a21d364e1  /tmp/npm-12.0.2.tgz" | sha256sum -c - \
    && rm -rf /usr/local/lib/node_modules/npm \
    && mkdir -p /usr/local/lib/node_modules/npm \
    && tar -xzf /tmp/npm-12.0.2.tgz -C /usr/local/lib/node_modules/npm --no-same-owner \
      --strip-components=1 \
    && curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error \
      -o /tmp/brace-expansion-5.0.9.tgz \
      https://registry.npmjs.org/brace-expansion/-/brace-expansion-5.0.9.tgz \
    && echo "5d06001fddd25cbee90c96db4dc5b7b57711b984c3141e28d10f143deb52dbaf  /tmp/brace-expansion-5.0.9.tgz" | sha256sum -c - \
    && rm -rf /usr/local/lib/node_modules/npm/node_modules/brace-expansion \
    && mkdir -p /usr/local/lib/node_modules/npm/node_modules/brace-expansion \
    && tar -xzf /tmp/brace-expansion-5.0.9.tgz \
      -C /usr/local/lib/node_modules/npm/node_modules/brace-expansion --no-same-owner \
      --strip-components=1 \
    && curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error \
      -o /tmp/ip-address-10.3.1.tgz \
      https://registry.npmjs.org/ip-address/-/ip-address-10.3.1.tgz \
    && echo "ad1790063beea11a312c801df30d58e147de762f4f77787552376eb7424623e5  /tmp/ip-address-10.3.1.tgz" | sha256sum -c - \
    && rm -rf /usr/local/lib/node_modules/npm/node_modules/ip-address \
    && mkdir -p /usr/local/lib/node_modules/npm/node_modules/ip-address \
    && tar -xzf /tmp/ip-address-10.3.1.tgz \
      -C /usr/local/lib/node_modules/npm/node_modules/ip-address --no-same-owner \
      --strip-components=1 \
    && curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error \
      -o /tmp/tar-7.5.21.tgz \
      https://registry.npmjs.org/tar/-/tar-7.5.21.tgz \
    && echo "bcedf25a21daecd1a18fb5e19ab855b7d79ec8ef1da175e8ba85cfc0ed0069d1  /tmp/tar-7.5.21.tgz" | sha256sum -c - \
    && rm -rf /usr/local/lib/node_modules/npm/node_modules/tar \
    && mkdir -p /usr/local/lib/node_modules/npm/node_modules/tar \
    && tar -xzf /tmp/tar-7.5.21.tgz \
      -C /usr/local/lib/node_modules/npm/node_modules/tar --no-same-owner \
      --strip-components=1 \
    && export NODE_DISABLE_COMPILE_CACHE=1 \
    && npm --version | grep -Fx "12.0.2" \
    && rm -rf /tmp/node-compile-cache \
    && rm -f /tmp/npm-12.0.2.tgz /tmp/brace-expansion-5.0.9.tgz /tmp/ip-address-10.3.1.tgz /tmp/tar-7.5.21.tgz

FROM docker.io/library/ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90 AS stateport-provider-empty
RUN mkdir -p /out
ARG STATEPORT_PROVIDER_IMAGE=stateport-provider-empty
FROM ${STATEPORT_PROVIDER_IMAGE} AS stateport-provider
FROM docker.io/library/node:22-alpine3.22@sha256:cd7807368cf24826297cbad5dca1a44972ccfd770647db52a8c7589eb4599ac8 AS provider-build
WORKDIR /provider
ARG STATEPORT_PROVIDER_MODE=official-npm
ARG STATEPORT_PROVIDER_MANIFEST_DIGEST=
ARG STATEPORT_PROVIDER_PLATFORM_MANIFEST_DIGEST=
ARG STATEPORT_PROVIDER_VERSION=
ARG STATEPORT_PROVIDER_BUBBLEWRAP_VERSION=
ARG STATEPORT_PROVIDER_RIPGREP_VERSION=
ARG STATEPORT_PROVIDER_SOURCE_COMMIT=
ARG STATEPORT_PROVIDER_SOURCE_ARCHIVE_DIGEST=
ARG STATEPORT_PROVIDER_BUILD_CONTEXT_DIGEST=
ARG STATEPORT_PROVIDER_CODEX_DIGEST=
ARG STATEPORT_PROVIDER_BUBBLEWRAP_DIGEST=
ARG STATEPORT_PROVIDER_RIPGREP_DIGEST=
RUN --mount=type=bind,from=stateport-provider,source=/out,target=/provider-input,readonly \
    set -eu \
    && mkdir -p /out \
    && if [ "$STATEPORT_PROVIDER_MODE" = official-npm ]; then :; \
       elif [ "$STATEPORT_PROVIDER_MODE" = custom-oci ]; then \
         export STATEPORT_PROVIDER_MANIFEST_DIGEST STATEPORT_PROVIDER_PLATFORM_MANIFEST_DIGEST STATEPORT_PROVIDER_VERSION \
           STATEPORT_PROVIDER_BUBBLEWRAP_VERSION STATEPORT_PROVIDER_RIPGREP_VERSION \
           STATEPORT_PROVIDER_SOURCE_COMMIT STATEPORT_PROVIDER_SOURCE_ARCHIVE_DIGEST \
           STATEPORT_PROVIDER_BUILD_CONTEXT_DIGEST STATEPORT_PROVIDER_CODEX_DIGEST \
           STATEPORT_PROVIDER_BUBBLEWRAP_DIGEST STATEPORT_PROVIDER_RIPGREP_DIGEST; \
         test -f /provider-input/provider-metadata.json \
           && test -x /provider-input/codex \
           && test -x /provider-input/bwrap \
           && test -x /provider-input/rg \
           && node -e 'const fs=require("fs"),m=JSON.parse(fs.readFileSync("/provider-input/provider-metadata.json")),d=/^sha256:[0-9a-f]{64}$/; const a=m.artifacts||{},s=m.source||{}; if(m.formatVersion!=="stateport.provider-runtime-metadata/v1"||m.version!==process.env.STATEPORT_PROVIDER_VERSION||m.bubblewrapVersion!==process.env.STATEPORT_PROVIDER_BUBBLEWRAP_VERSION||m.ripgrepVersion!==process.env.STATEPORT_PROVIDER_RIPGREP_VERSION||s.repository!=="https://github.com/openai/codex"||s.commit!==process.env.STATEPORT_PROVIDER_SOURCE_COMMIT||s.sourceArchiveDigest!==process.env.STATEPORT_PROVIDER_SOURCE_ARCHIVE_DIGEST||s.buildContextDigest!==process.env.STATEPORT_PROVIDER_BUILD_CONTEXT_DIGEST||!d.test(a.codex?.digest)||!d.test(a.bubblewrap?.digest)||!d.test(a.ripgrep?.digest)||a.codex?.digest!==process.env.STATEPORT_PROVIDER_CODEX_DIGEST||a.bubblewrap?.digest!==process.env.STATEPORT_PROVIDER_BUBBLEWRAP_DIGEST||a.ripgrep?.digest!==process.env.STATEPORT_PROVIDER_RIPGREP_DIGEST||!Array.isArray(m.licenses)||m.licenses.join(",")!=="LICENSE,NOTICE,BUBBLEWRAP-LICENSE,BUBBLEWRAP-NOTICE") process.exit(1)' \
           && test "$(sha256sum /provider-input/codex | cut -d' ' -f1)" = "${STATEPORT_PROVIDER_CODEX_DIGEST#sha256:}" \
           && test "$(sha256sum /provider-input/bwrap | cut -d' ' -f1)" = "${STATEPORT_PROVIDER_BUBBLEWRAP_DIGEST#sha256:}" \
           && test "$(sha256sum /provider-input/rg | cut -d' ' -f1)" = "${STATEPORT_PROVIDER_RIPGREP_DIGEST#sha256:}" \
           && test "$(/provider-input/codex --version)" = "$STATEPORT_PROVIDER_VERSION" \
           && test "$(/provider-input/bwrap --version | head -n1)" = "$STATEPORT_PROVIDER_BUBBLEWRAP_VERSION" \
           && test "$(/provider-input/rg --version | head -n1)" = "$STATEPORT_PROVIDER_RIPGREP_VERSION" \
           && for license in LICENSE NOTICE BUBBLEWRAP-LICENSE BUBBLEWRAP-NOTICE; do test -f "/provider-input/$license"; cp "/provider-input/$license" "/out/$license"; done \
           && cp /provider-input/codex /out/codex \
           && cp /provider-input/bwrap /out/bwrap \
           && cp /provider-input/rg /out/rg \
           && chmod 0555 /out/codex /out/bwrap /out/rg; \
       else echo "unsupported provider input mode" >&2; exit 1; fi

FROM workspace
ARG STATEPORT_PROVIDER_MODE=official-npm
ARG STATEPORT_BUILD_SOURCE_COMMIT=unknown
ARG STATEPORT_BUILD_SOURCE_TREE=unknown
ARG STATEPORT_BUILD_SOURCE_REF=unknown
ARG STATEPORT_BUILD_SOURCE_DIRTY=true
ARG STATEPORT_BUILD_SOURCE_DATE_EPOCH=unknown
ARG STATEPORT_BUILD_VERSION=0.0.0-unknown
ARG STATEPORT_BUILD_CREATED=1970-01-01T00:00:00Z
ARG STATEPORT_BUILD_ADAPTER=unknown
COPY config/codex-runtime/package.json config/codex-runtime/package-lock.json /opt/stateport-codex/
COPY images/bin/stateport-healthcheck /usr/local/bin/stateport-healthcheck
# npm and the codex smoke test write wall-clock-named logs, cache index
# entries, and a randomly-named arg0 extraction directory under $HOME. Build
# with a throwaway HOME/cache and remove them so the layer is reproducible;
# the runtime HOME/CODEX_HOME are set by the ENV below. Node also persists a
# V8 compile cache under $TMPDIR whose entries embed build paths; disable it
# explicitly and remove the directory for the same reason.
RUN export HOME=/tmp/stateport-build-home \
    && export CODEX_HOME=/tmp/stateport-build-home/.codex \
    && export NODE_DISABLE_COMPILE_CACHE=1 \
    && mkdir -p "$HOME" \
    && if [ "$STATEPORT_PROVIDER_MODE" = official-npm ]; then \
         cd /opt/stateport-codex \
         && npm ci --ignore-scripts --omit=dev --audit=false --fund=false \
           --cache /tmp/stateport-npm-cache \
         && ln -s /opt/stateport-codex/node_modules/.bin/codex /usr/local/bin/codex \
         && codex --version | grep -Fx "codex-cli 0.146.0"; \
       elif [ "$STATEPORT_PROVIDER_MODE" != custom-oci ]; then \
         echo "unsupported provider input mode" >&2; exit 1; \
       fi \
    && chmod 0555 /usr/local/bin/stateport-healthcheck \
    && test ! -e /home/stateport/.codex/auth.json \
    && rm -rf /tmp/stateport-build-home /tmp/stateport-npm-cache /tmp/node-compile-cache

COPY --from=provider-build /out /tmp/stateport-provider-inputs
RUN if [ "$STATEPORT_PROVIDER_MODE" = custom-oci ]; then \
      rm -f /usr/local/bin/codex /usr/local/bin/rg /usr/bin/bwrap \
      && install -m 0555 /tmp/stateport-provider-inputs/codex /usr/local/bin/codex \
      && install -m 0555 /tmp/stateport-provider-inputs/rg /usr/local/bin/rg \
      && install -m 0555 /tmp/stateport-provider-inputs/bwrap /usr/bin/bwrap \
      && install -d -m 0555 /usr/share/licenses/stateport-provider \
      && install -m 0444 /tmp/stateport-provider-inputs/LICENSE /usr/share/licenses/stateport-provider/LICENSE \
      && install -m 0444 /tmp/stateport-provider-inputs/NOTICE /usr/share/licenses/stateport-provider/NOTICE \
      && install -m 0444 /tmp/stateport-provider-inputs/BUBBLEWRAP-LICENSE /usr/share/licenses/stateport-provider/BUBBLEWRAP-LICENSE \
      && install -m 0444 /tmp/stateport-provider-inputs/BUBBLEWRAP-NOTICE /usr/share/licenses/stateport-provider/BUBBLEWRAP-NOTICE; \
    fi \
    && rm -rf /tmp/stateport-provider-inputs

ENV HOME=/home/stateport \
    CODEX_HOME=/home/stateport/.codex \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8
WORKDIR /workspace
USER 10001:10001
CMD ["/bin/bash", "-l"]
