{
  "schema": "stateport.local-artifact-policy/v1",
  "localRoots": [
    {
      "path": ".commandcode",
      "classification": "agent_tool_local_metadata"
    },
    {
      "path": ".stateport-local",
      "classification": "operator_local_state"
    },
    {
      "path": "apps/web/playwright-report",
      "classification": "browser_report"
    },
    {
      "path": "apps/web/test-results",
      "classification": "browser_test_output"
    },
    {
      "path": "docs/audit",
      "classification": "operator_private_evidence"
    },
    {
      "path": "release-output",
      "classification": "generated_release_output"
    }
  ],
  "sourceLikeSuffixes": [
    ".c",
    ".css",
    ".go",
    ".h",
    ".html",
    ".java",
    ".js",
    ".json",
    ".jsx",
    ".md",
    ".mjs",
    ".py",
    ".rs",
    ".sh",
    ".tf",
    ".ts",
    ".tsx",
    ".yaml",
    ".yml"
  ],
  "prohibitedTrackedSuffixes": [
    ".db",
    ".mp4",
    ".sqlite",
    ".sqlite3",
    ".sqlite3-shm",
    ".sqlite3-wal",
    ".trace.zip",
    ".webm"
  ],
  "prohibitedTrackedBasenames": [
    ".env"
  ]
}
