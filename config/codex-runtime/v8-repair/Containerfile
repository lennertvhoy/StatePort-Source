# Local preparation pilot only. Both filesystem inputs are already retained.
# No provider artifact or public release route consumes this image.
FROM docker.io/library/rust:1.95.0-alpine3.23@sha256:606fd313a0f49743ee2a7bd49a0914bab7deedb12791f3a846a34a4711db7ed2 AS musl
FROM 127.0.0.1:5000/stateport-alpha/stateport-dev-workspace@sha256:bf0db6cfaef704cfb6a49127b4e23059eec55c0fbb25f4372c4852b4ec5c9712
USER 0
COPY --from=musl /usr/include/ /opt/stateport-musl-sysroot/usr/include/
COPY --from=musl /usr/lib/libc.a /usr/lib/crt1.o /usr/lib/Scrt1.o /usr/lib/crti.o /usr/lib/crtn.o /usr/lib/rcrt1.o /opt/stateport-musl-sysroot/usr/lib/
RUN cp -R /usr/include/linux /usr/include/asm-generic /opt/stateport-musl-sysroot/usr/include/ \
    && cp -R /usr/include/x86_64-linux-gnu/asm /opt/stateport-musl-sysroot/usr/include/
COPY config/codex-runtime/v8-repair/ /opt/stateport-v8-repair/
WORKDIR /work
ENTRYPOINT ["python3", "/opt/stateport-v8-repair/pilot.py"]
