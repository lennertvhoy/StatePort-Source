diff --git a/source/common/unicode/utfiterator.h b/source/common/unicode/utfiterator.h
index 7e9fc4ba314d..6e79a4403057 100644
--- a/source/common/unicode/utfiterator.h
+++ b/source/common/unicode/utfiterator.h
@@ -557,9 +557,11 @@ class UTFImpl<
 public:
     // Handle ill-formed UTF-8
     U_FORCE_INLINE static CP32 sub() {
-        switch (behavior) {
-            case UTF_BEHAVIOR_NEGATIVE: return U_SENTINEL;
-            case UTF_BEHAVIOR_FFFD: return 0xfffd;
+        if constexpr (behavior == UTF_BEHAVIOR_NEGATIVE) {
+            return U_SENTINEL;
+        } else {
