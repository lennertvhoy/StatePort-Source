--- a/codex-rs/linux-sandbox/src/linux_run_main_tests.rs
+++ b/codex-rs/linux-sandbox/src/linux_run_main_tests.rs
@@ -45,6 +45,26 @@
 fn ignores_non_proc_mount_errors() {
