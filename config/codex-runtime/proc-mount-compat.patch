+}
+
+#[test]
+fn detects_current_bubblewrap_proc_mount_failures() {
+    for error in ["Invalid argument", "Operation not permitted", "Permission denied"] {
+        assert!(is_proc_mount_failure(&format!("bwrap: Can't mount proc on /proc: {error}")));
+    }
+}
+
+#[test]
+fn refuses_unrelated_proc_paths_and_errors() {
+    for stderr in [
+        "bwrap: Can't mount proc on /proc-other: Operation not permitted",
+        "bwrap: Can't mount proc on /newroot/proc-other: Invalid argument",
+        "bwrap: Can't bind mount /proc: Operation not permitted",
+        "bwrap: Can't mount proc on /proc: No such file or directory",
+        "bwrap: Can't mount proc on /tmp/proc: Permission denied",
+    ] {
+        assert!(!is_proc_mount_failure(stderr));
+    }
 }
 
