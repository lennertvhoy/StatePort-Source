# Preparation build only. Release images do not consume this artifact until
# reproducibility, vulnerability review and the actual CLI sandbox probe pass.
FROM docker.io/library/rust:1.95.0-alpine3.23@sha256:606fd313a0f49743ee2a7bd49a0914bab7deedb12791f3a846a34a4711db7ed2 AS build
RUN apk add --no-cache build-base=0.5-r3 cmake=4.1.3-r0 \
      clang21=21.1.2-r2 clang21-libclang=21.1.2-r2 \
      lld21=21.1.2-r1 lld21-libs=21.1.2-r1 scudo-malloc=21.1.2-r0 \
      git=2.52.0-r0 linux-headers=6.16.12-r0 openssl-dev=3.5.8-r0 \
      perl=5.42.2-r0 pkgconf=2.5.1-r0 python3=3.12.14-r0 \
      openssl-libs-static=3.5.8-r0 zlib-static=1.3.2-r0 bzip2-static=1.0.8-r6 \
      xz-static=5.8.3-r0 brotli-static=1.2.0-r0 zstd-static=1.5.7-r2
WORKDIR /build
COPY config/codex-runtime/source-build.json config/codex-runtime/proc-mount-compat.patch config/codex-runtime/dependency-updates.patch config/codex-runtime/prepare-source.py /build/inputs/
RUN python3 -c 'import json, urllib.request; d=json.load(open("inputs/source-build.json")); urllib.request.urlretrieve(d["sourceUrl"], "source.tar.gz")' \
    && python3 inputs/prepare-source.py source.tar.gz source
# Upstream's own musl V8 archive and bindings, with the published checksums
# pinned here rather than trusting a mutable checksum download during builds.
RUN python3 -c 'import urllib.request; base="https://github.com/openai/codex/releases/download/rusty-v8-v149.2.0/"; [urllib.request.urlretrieve(base+n,n) for n in ("librusty_v8_release_x86_64-unknown-linux-musl.a.gz", "src_binding_release_x86_64-unknown-linux-musl.rs")]' \
    && echo '232a860a60790dc59af99e360e1f3b2ba882c8a1aaaeb055a2a482eddbce8c70  librusty_v8_release_x86_64-unknown-linux-musl.a.gz' | sha256sum -c - \
    && echo '5db3ec0783531d12862a3f38dd5a679273550e67962260b81f07e612a68a0c24  src_binding_release_x86_64-unknown-linux-musl.rs' | sha256sum -c -
RUN printf '%s\n' '#!/bin/sh' 'exec /usr/bin/cc "$@" -B/usr/bin -fuse-ld=lld -Wl,--threads=1' \
      > /usr/local/bin/stateport-musl-linker \
    && chmod 0755 /usr/local/bin/stateport-musl-linker
ENV CARGO_BUILD_JOBS=1 \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=/usr/local/bin/stateport-musl-linker \
    RUSTUP_TOOLCHAIN=1.95.0 \
    OPENSSL_STATIC=1 \
    OPENSSL_NO_VENDOR=1 \
    PKG_CONFIG_ALL_STATIC=1 \
    RUSTY_V8_ARCHIVE=/build/librusty_v8_release_x86_64-unknown-linux-musl.a.gz \
    RUSTY_V8_SRC_BINDING_PATH=/build/src_binding_release_x86_64-unknown-linux-musl.rs \
    AWS_LC_SYS_NO_JITTER_ENTROPY=1 \
    LIBCLANG_PATH=/usr/lib/llvm21/lib \
    CARGO_PROFILE_RELEASE_OPT_LEVEL=1 \
    CARGO_PROFILE_RELEASE_DEBUG=0 \
    CARGO_PROFILE_RELEASE_LTO=off \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16
WORKDIR /build/source/codex-e363b08c9175ac1cbe5893615dd2cb9ddf95043b/codex-rs
RUN test "$(pkg-config --modversion openssl)" = 3.5.8 \
    && cargo build --locked --release --target x86_64-unknown-linux-musl --bin codex
RUN mkdir /out \
    && cp target/x86_64-unknown-linux-musl/release/codex /out/codex \
    && strip --strip-debug --strip-unneeded /out/codex \
    && version=$(/out/codex --version) \
    && test "$version" = 'codex-cli 0.146.0+stateport.2' \
    && readelf -l /out/codex > /out/elf-program-headers.txt \
    && ! grep -q INTERP /out/elf-program-headers.txt
RUN cp /build/source/source-preparation.json /out/source-preparation.json \
    && cp Cargo.lock /out/Cargo.lock \
    && cp ../LICENSE ../NOTICE /out/ \
    && cargo tree --locked --offline --target x86_64-unknown-linux-musl \
      --package codex-cli --edges normal > /out/runtime-dependencies.txt \
    && cargo tree --locked --offline --target x86_64-unknown-linux-musl \
      --package codex-cli --edges normal --prefix none \
      --format '{p} features={f}' > /out/runtime-features.txt \
    && rustc --version --verbose > /out/rustc.txt \
    && ld.lld --version > /out/linker-version.txt \
    && apk info -vv > /out/build-packages.txt \
    && pkg-config --modversion openssl > /out/openssl-library-version.txt \
    && sha256sum /out/codex > /out/codex.sha256
FROM scratch
COPY --from=build /out/ /
