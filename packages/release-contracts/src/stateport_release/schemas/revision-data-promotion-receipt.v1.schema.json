{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.invalid/schemas/revision-data-promotion-receipt.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "operationPlanDigest", "activationPlanDigest", "promotionSpecDigest", "releaseId", "signedPayloadDigest", "targetId", "topologyDigest", "predecessorPointerDigest", "predecessorReleaseId", "predecessorSignedPayloadDigest", "predecessorDataGeneration", "predecessorDataGenerationDigest", "predecessorVolumeNames", "backupDigestD0", "acceptedDataGeneration", "acceptedDataGenerationDigest", "volumeBindings", "migrationReceiptDigest", "privateChecksReceiptDigest", "authoritativeWriterFenceReceiptDigest", "fsyncReceiptDigest", "validationDataDisposition", "externalSideEffects", "completedAt", "result", "receiptDigest"],
  "properties": {
    "schema": {"const": "stateport.revision-data-promotion-receipt/v1"},
    "operationPlanDigest": {"$ref": "#/$defs/digest"},
    "activationPlanDigest": {"$ref": "#/$defs/digest"},
    "promotionSpecDigest": {"$ref": "#/$defs/digest"},
    "releaseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "signedPayloadDigest": {"$ref": "#/$defs/digest"},
    "targetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "topologyDigest": {"$ref": "#/$defs/digest"},
    "predecessorPointerDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "predecessorReleaseId": {"oneOf": [{"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"}, {"type": "null"}]},
    "predecessorSignedPayloadDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "predecessorDataGeneration": {"oneOf": [{"type": "string", "pattern": "^data_[0-9a-f]{32}$"}, {"type": "null"}]},
    "predecessorDataGenerationDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "predecessorVolumeNames": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,127}$"}},
    "backupDigestD0": {"$ref": "#/$defs/digest"},
    "acceptedDataGeneration": {"type": "string", "pattern": "^data_[0-9a-f]{32}$"},
    "acceptedDataGenerationDigest": {"$ref": "#/$defs/digest"},
    "volumeBindings": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["volumeKey", "volumeName", "dataGeneration"], "properties": {"volumeKey": {"type": "string", "pattern": "^stateport-[a-z0-9-]+:[a-z][a-z0-9-]{0,62}$"}, "volumeName": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,127}$"}, "dataGeneration": {"type": "string", "pattern": "^data_[0-9a-f]{32}$"}}}},
    "migrationReceiptDigest": {"$ref": "#/$defs/digest"},
    "privateChecksReceiptDigest": {"$ref": "#/$defs/digest"},
    "authoritativeWriterFenceReceiptDigest": {"$ref": "#/$defs/digest"},
    "fsyncReceiptDigest": {"$ref": "#/$defs/digest"},
    "validationDataDisposition": {"const": "discarded-not-promoted"},
    "externalSideEffects": {"const": "not-reversed-by-filesystem-restore"},
    "completedAt": {"$ref": "#/$defs/timestamp"},
    "result": {"const": "succeeded"},
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}}
}
