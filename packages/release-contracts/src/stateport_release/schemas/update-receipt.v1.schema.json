{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.invalid/schemas/update-receipt.v1.schema.json",
  "title": "StatePort update receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receiptId", "installationId", "planId", "planDigest", "operation", "from", "attempted", "accepted", "releaseIndexDigest", "backupReceipt", "checks", "rollback", "authority", "startedAt", "finishedAt", "result"],
  "properties": {
    "schema": {"const": "stateport.update-receipt/v1"},
    "receiptId": {"type": "string", "pattern": "^update_receipt_[0-9a-f]{32}$"},
    "installationId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "planId": {"type": "string", "pattern": "^update_plan_[0-9a-f]{32}$"},
    "planDigest": {"$ref": "#/$defs/digest"},
    "operation": {"enum": ["update", "rollback"]},
    "from": {"$ref": "#/$defs/release"},
    "attempted": {"$ref": "#/$defs/release"},
    "accepted": {"$ref": "#/$defs/release"},
    "releaseIndexDigest": {"$ref": "#/$defs/digest"},
    "backupReceipt": {"type": "string", "minLength": 1, "maxLength": 256},
    "checks": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"enum": ["passed", "failed", "not_run"]}
    },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["attempted", "succeeded", "retainedFailureEvidence"],
      "properties": {
        "attempted": {"type": "boolean"},
        "succeeded": {"type": "boolean"},
        "retainedFailureEvidence": {"type": "boolean"}
      }
    },
    "authority": {"$ref": "#/$defs/authorityReference"},
    "startedAt": {"$ref": "#/$defs/timestamp"},
    "finishedAt": {"$ref": "#/$defs/timestamp"},
    "result": {"enum": ["accepted", "rolled_back", "failed_safe", "not_executed"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "authorityReference": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "actorId", "grantId", "grantDigest", "profile", "configuredPolicy", "effectivePolicy", "scope", "runId", "planDigest", "requestId", "decisionDigest", "reservationId", "reservationDigest", "claimId", "claimDigest"],
      "properties": {
        "action": {"enum": ["apply_update", "rollback_update"]},
        "actorId": {"type": "string", "minLength": 1, "maxLength": 128},
        "grantId": {"type": "string", "pattern": "^grant_[A-Za-z0-9._-]{3,120}$"},
        "grantDigest": {"$ref": "#/$defs/digest"},
        "profile": {"enum": ["guarded", "balanced", "delegated", "custom"]},
        "configuredPolicy": {"enum": ["approve_scope_once", "auto_and_notify", "auto_with_receipt"]},
        "effectivePolicy": {"enum": ["approve_scope_once", "auto_and_notify", "auto_with_receipt"]},
        "scope": {"$ref": "#/$defs/authorityScope"},
        "runId": {"$ref": "#/$defs/digest"},
        "planDigest": {"$ref": "#/$defs/digest"},
        "requestId": {"type": "string", "pattern": "^authority_request_[0-9a-f]{32}$"},
        "decisionDigest": {"$ref": "#/$defs/digest"},
        "reservationId": {"type": "string", "pattern": "^authority_reservation_[0-9a-f]{32}$"},
        "reservationDigest": {"$ref": "#/$defs/digest"},
        "claimId": {"type": "string", "pattern": "^authority_claim_[0-9a-f]{32}$"},
        "claimDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "authorityScope": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "branch", "sliceId", "applicationId", "runId", "paths"],
      "properties": {
        "repository": {
          "type": "object", "additionalProperties": false,
          "required": ["origin", "repositoryKey", "repositoryRoot"],
          "properties": {
            "origin": {"type": "string", "pattern": "^https://[^\\s?#]+(?:\\.git)?$"},
            "repositoryKey": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
            "repositoryRoot": {"type": "string", "pattern": "^/", "maxLength": 4096}
          }
        },
        "branch": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 255}, {"type": "null"}]},
        "sliceId": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]},
        "applicationId": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]},
        "runId": {"$ref": "#/$defs/digest"},
        "paths": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
      }
    },
    "release": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["releaseId", "version", "channel", "signedPayloadDigest", "imageSetDigest", "sourceCommit", "sourceTree", "qualification", "publishedAt"],
          "properties": {
            "releaseId": {"type": "string", "minLength": 3, "maxLength": 128},
            "version": {"type": "string", "minLength": 5, "maxLength": 128},
            "channel": {"enum": ["alpha", "stable", "owner-dogfood"]},
            "signedPayloadDigest": {"$ref": "#/$defs/digest"},
            "imageSetDigest": {"$ref": "#/$defs/digest"},
            "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "sourceTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "qualification": {"enum": ["candidate", "published"]},
            "publishedAt": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
          }
        },
        {"type": "null"}
      ]
    }
  }
}
