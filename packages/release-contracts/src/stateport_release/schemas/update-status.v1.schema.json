{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.invalid/schemas/update-status.v1.schema.json",
  "title": "StatePort durable update status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sequence", "phase", "installationId", "policy", "current", "accepted", "retainedPredecessor", "stagedSuccessor", "failedSuccessorEvidence", "lastReceipt", "updatedAt"],
  "properties": {
    "schema": {"const": "stateport.update-status/v1"},
    "sequence": {"type": "integer", "minimum": 0},
    "phase": {"enum": ["idle", "checking", "planned", "approved", "downloading", "staged", "validating", "switching", "accepted", "rolling_back", "rolled_back", "failed_safe"]},
    "installationId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "policy": {"$ref": "#/$defs/updatePolicy"},
    "current": {"$ref": "#/$defs/nullableRelease"},
    "accepted": {"$ref": "#/$defs/nullableRelease"},
    "retainedPredecessor": {"$ref": "#/$defs/nullableRelease"},
    "stagedSuccessor": {"$ref": "#/$defs/nullableRelease"},
    "failedSuccessorEvidence": {"oneOf": [{"type": "string", "pattern": "^update_failure_[0-9a-f]{32}$"}, {"type": "null"}]},
    "lastReceipt": {"oneOf": [{"type": "string", "pattern": "^update_receipt_[0-9a-f]{32}$"}, {"type": "null"}]},
    "updatedAt": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "updatePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "channel", "policyDigest", "schedule", "retention", "downloadAhead"],
      "properties": {
        "mode": {"enum": ["manual", "notify", "download-and-notify", "scheduled", "automatic-with-rollback"]},
        "channel": {"enum": ["alpha", "stable", "owner-dogfood"]},
        "policyDigest": {"$ref": "#/$defs/digest"},
        "schedule": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["daysOfWeek", "startMinuteUtc"], "properties": {"daysOfWeek": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 7}}, "startMinuteUtc": {"type": "integer", "minimum": 0, "maximum": 1439}}},
            {"type": "null"}
          ]
        },
        "retention": {"type": "object", "additionalProperties": false, "required": ["acceptedPredecessors", "failedSuccessors", "maximumVersions", "maximumAgeDays"], "properties": {"acceptedPredecessors": {"type": "integer", "minimum": 1, "maximum": 16}, "failedSuccessors": {"type": "integer", "minimum": 1, "maximum": 16}, "maximumVersions": {"type": "integer", "minimum": 3, "maximum": 64}, "maximumAgeDays": {"type": "integer", "minimum": 1, "maximum": 3650}}},
        "downloadAhead": {"type": "boolean"}
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["releaseId", "version", "signedPayloadDigest"],
      "properties": {
        "releaseId": {"type": "string", "minLength": 3, "maxLength": 128},
        "version": {"type": "string", "minLength": 5, "maxLength": 128},
        "signedPayloadDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "nullableRelease": {"oneOf": [{"$ref": "#/$defs/release"}, {"type": "null"}]}
  }
}
