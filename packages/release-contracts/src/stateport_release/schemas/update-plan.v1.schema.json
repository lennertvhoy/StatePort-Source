{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateport.invalid/schemas/update-plan.v1.schema.json",
  "title": "StatePort update plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "planId", "planDigest", "operation", "installationId", "current", "successor", "releaseIndexDigest", "signedPayloadDigest", "policy", "estimatedPullBytes", "compatibility", "backupRequired", "steps", "rollback", "authority", "createdAt", "expiresAt"],
  "properties": {
    "schema": {"const": "stateport.update-plan/v1"},
    "planId": {"type": "string", "pattern": "^update_plan_[0-9a-f]{32}$"},
    "planDigest": {"$ref": "#/$defs/digest"},
    "operation": {"enum": ["update", "rollback"]},
    "installationId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "current": {"$ref": "#/$defs/release"},
    "successor": {"$ref": "#/$defs/release"},
    "releaseIndexDigest": {"$ref": "#/$defs/digest"},
    "signedPayloadDigest": {"$ref": "#/$defs/digest"},
    "policy": {"$ref": "#/$defs/updatePolicy"},
    "estimatedPullBytes": {"type": "integer", "minimum": 1, "maximum": 549755813888},
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["updaterCompatible", "migrationCompatible", "rollbackCompatible", "downgrade"],
      "properties": {
        "updaterCompatible": {"type": "boolean"},
        "migrationCompatible": {"type": "boolean"},
        "rollbackCompatible": {"type": "boolean"},
        "downgrade": {"type": "boolean"}
      }
    },
    "backupRequired": {"const": true},
    "steps": {
      "type": "array", "minItems": 12, "maxItems": 15, "uniqueItems": true,
      "items": {"enum": ["verify", "backup", "pull", "stage", "dry-run-migrations", "start-successor", "health-successor", "browser-successor", "studystate-successor", "state-check-successor", "switch", "health-accepted-route", "state-check-accepted-route", "retain-predecessor", "record-receipt"]}
    },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["automaticOnFailure", "retainedPredecessor", "dataCompatible"],
      "properties": {
        "automaticOnFailure": {"type": "boolean"},
        "retainedPredecessor": {"const": true},
        "dataCompatible": {"type": "boolean"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "runId", "status"],
      "properties": {
        "action": {"enum": ["apply_update", "rollback_update"]},
        "runId": {"$ref": "#/$defs/digest"},
        "status": {"const": "awaiting_authority_claim"}
      }
    },
    "createdAt": {"$ref": "#/$defs/timestamp"},
    "expiresAt": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "updatePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "channel", "policyDigest", "schedule", "retention", "downloadAhead"],
      "properties": {
        "mode": {"enum": ["manual", "notify", "download-and-notify", "scheduled", "automatic-with-rollback"]},
        "channel": {"enum": ["alpha", "stable", "owner-dogfood"]},
        "policyDigest": {"$ref": "#/$defs/digest"},
        "schedule": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["daysOfWeek", "startMinuteUtc"],
              "properties": {
                "daysOfWeek": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 7}},
                "startMinuteUtc": {"type": "integer", "minimum": 0, "maximum": 1439}
              }
            },
            {"type": "null"}
          ]
        },
        "retention": {
          "type": "object", "additionalProperties": false,
          "required": ["acceptedPredecessors", "failedSuccessors", "maximumVersions", "maximumAgeDays"],
          "properties": {
            "acceptedPredecessors": {"type": "integer", "minimum": 1, "maximum": 16},
            "failedSuccessors": {"type": "integer", "minimum": 1, "maximum": 16},
            "maximumVersions": {"type": "integer", "minimum": 3, "maximum": 64},
            "maximumAgeDays": {"type": "integer", "minimum": 1, "maximum": 3650}
          }
        },
        "downloadAhead": {"type": "boolean"}
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["releaseId", "version", "channel", "signedPayloadDigest", "imageSetDigest", "sourceCommit", "sourceTree", "qualification", "publishedAt"],
      "properties": {
        "releaseId": {"type": "string", "minLength": 3, "maxLength": 128},
        "version": {"type": "string", "minLength": 5, "maxLength": 128},
        "channel": {"enum": ["alpha", "stable", "owner-dogfood"]},
        "signedPayloadDigest": {"$ref": "#/$defs/digest"},
        "imageSetDigest": {"$ref": "#/$defs/digest"},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sourceTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "qualification": {"enum": ["candidate", "published"]},
        "publishedAt": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
      }
    }
  }
}
